@prefix sdp-m: <https://ontology.example.com/domain/rwpa/self-directed-planning/governance/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix ent-tax: <https://ontology.example.com/taxonomy/> .
@prefix ent-cap: <https://ontology.example.com/capability/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# DOMAIN MANIFEST - Self-Directed Wealth Planning, Insights & Analytics
#
# The machine-readable statement of what this domain is accountable for and
# who holds each accountability. CI validates it (ent-ms:DomainManifestShape)
# and generates CODEOWNERS from it. Keep role holders current.
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/rwpa/self-directed-planning/governance/>
    a owl:Ontology ;
    rdfs:label "Self-Directed Wealth Planning, Insights & Analytics - domain governance"@en ;
    dct:abstract "Domain manifest, accountable roles, knowledge collections and execution models of the Self-Directed Wealth Planning, Insights & Analytics sub-domain."@en ;
    owl:imports <https://ontology.example.com/governance/model/> ;
    owl:versionIRI <https://ontology.example.com/domain/rwpa/self-directed-planning/governance/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

sdp-m:Manifest a ent-gov:DomainManifest ;
    rdfs:label "Self-Directed Wealth Planning, Insights & Analytics domain manifest"@en ;
    ent-gov:describesDomain <https://ontology.example.com/capability/domain/retail-wealth-planning-and-advisory/self-directed-wealth-planning-insights-and-analytics> ;
    ent-gov:namespace "https://ontology.example.com/domain/rwpa/self-directed-planning/"^^xsd:anyURI ;
    ent-gov:codeRepository "https://github.com/example-org/rwpa-self-directed-planning"^^xsd:anyURI ;
    ent-gov:hasOntologyModule <https://ontology.example.com/domain/rwpa/self-directed-planning/planning/> ;
    ent-gov:anchoredTo ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ,
        ent-tax:customers.customer-intelligence-and-analytics.customer-financial-health-scores ,
        ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics ,
        ent-tax:products-and-services.planning-and-guidance-services ,
        ent-tax:products-and-services.financial-wellness-services ;
    ent-gov:realizesCapability ent-cap:cap-rwpa-01 , ent-cap:cap-rwpa-02 , ent-cap:cap-rwpa-03 , ent-cap:cap-rwpa-04 ;
    ent-gov:hasDomainOwner sdp-m:DomainOwnerRole ;
    ent-gov:hasRuleOwner sdp-m:RuleOwnerRole ;
    ent-gov:hasApiOwner sdp-m:ApiOwnerRole ;
    ent-gov:hasDataSteward sdp-m:DataStewardRole ;
    ent-gov:hasRecordsOwner sdp-m:RecordsOwnerRole ;
    dct:created "2026-09-28"^^xsd:date .

# ---- Accountable roles (MEANING, RULES, APIs, DATA, RECORDS) -------------------

sdp-m:DomainOwnerRole a ent-gov:DomainOwner ;
    rdfs:label "Self-Directed Wealth Planning, Insights & Analytics domain owner"@en ;
    ent-gov:accountableFor ent-gov:Meaning ;
    ent-gov:heldBy "Head of Digital Wealth Planning (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwpa-domain-owners" .

sdp-m:RuleOwnerRole a ent-gov:RuleOwner ;
    rdfs:label "Self-Directed Wealth Planning, Insights & Analytics rule owner"@en ;
    ent-gov:accountableFor ent-gov:Rules ;
    ent-gov:heldBy "Wealth Planning Rules Lead (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwpa-rule-owners" .

sdp-m:ApiOwnerRole a ent-gov:ApiOwner ;
    rdfs:label "Self-Directed Wealth Planning, Insights & Analytics API owner"@en ;
    ent-gov:accountableFor ent-gov:Apis ;
    ent-gov:heldBy "Planning Platform Product Owner (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwpa-api-owners" .

sdp-m:DataStewardRole a ent-gov:DataSteward ;
    rdfs:label "Self-Directed Wealth Planning, Insights & Analytics data steward"@en ;
    ent-gov:accountableFor ent-gov:Data ;
    ent-gov:heldBy "Planning Data Steward (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwpa-data-stewards" .

sdp-m:RecordsOwnerRole a ent-gov:RecordsOwner ;
    rdfs:label "Self-Directed Wealth Planning, Insights & Analytics records owner"@en ;
    ent-gov:accountableFor ent-gov:Records ;
    ent-gov:heldBy "Wealth Records Manager (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwpa-records" .

# Enterprise role referenced by this domain's risk assessments (approver, not owner)
sdp-m:AIRiskApprover a ent-gov:AIRiskOwner ;
    rdfs:label "AI risk approver for Self-Directed Wealth Planning, Insights & Analytics"@en ;
    ent-gov:accountableFor ent-gov:AIRiskAndControls ;
    ent-gov:heldBy "AI Risk Office (placeholder)" ;
    ent-gov:reviewTeam "@example-org/ai-risk-office" .
