@prefix sdp:      <https://ontology.example.com/domain/rwpa/self-directed-planning/planning/> .
@prefix sdp-rule: <https://ontology.example.com/domain/rwpa/self-directed-planning/rules/> .
@prefix sdp-m:    <https://ontology.example.com/domain/rwpa/self-directed-planning/governance/> .
@prefix ent-gov:  <https://ontology.example.com/governance/model/> .
@prefix ent-av:   <https://ontology.example.com/governance/annotations/> .
@prefix ent-tax:  <https://ontology.example.com/taxonomy/> .
@prefix ent-ra:   <https://ontology.example.com/fabric/assets/> .
@prefix ent-core: <https://ontology.example.com/fibo-ext/core/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Self-Directed Wealth Planning - BUSINESS RULES
# RULES owned by: RWPA-SDP rule owner. Each rule: id, authoritative statement,
# policy source, owner, taxonomy anchor, executable shape, >=1 negative test.
# Policy sources are PLACEHOLDERS for the firm's actual policy references.
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/rwpa/self-directed-planning/rules/>
    a owl:Ontology ;
    rdfs:label "Self-Directed Wealth Planning - business rules"@en ;
    dct:abstract "Executable business rules for goals, projections, health scores and self-directed insights, including the advice-boundary rule."@en ;
    owl:versionIRI <https://ontology.example.com/domain/rwpa/self-directed-planning/rules/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional ;
    sh:declare [ sh:prefix "sdp" ; sh:namespace "https://ontology.example.com/domain/rwpa/self-directed-planning/planning/"^^xsd:anyURI ] .

# ---- SDP-R-001  Advice boundary --------------------------------------------------

sdp-rule:AdviceBoundaryRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "advice boundary rule"@en ;
    ent-av:ruleIdentifier "SDP-R-001" ;
    ent-av:ruleStatement "A self-directed insight must be delivered under the self-directed delivery model and must not recommend buying or selling a specific security; such recommendations are personalized advice and belong to the advised channel."@en ;
    ent-av:policySource "Retail advice boundary policy (placeholder ref RP-ADV-004); alignment decision ALN-002" ;
    ent-gov:hasRuleOwner sdp-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:products-and-services.personalized-planning-and-guidance-services ;
    ent-av:agentGuidance "Enforced at runtime by rule pack sdp_advice_boundary_rulepack (CTL-005). If violated, block delivery and offer to connect the customer with the advised channel."@en ;
    sh:targetClass sdp:SelfDirectedInsight ;
    sh:message "SDP-R-001: a self-directed insight must not recommend buying or selling a specific security." ;
    sh:property [
        sh:path ent-core:hasDeliveryModel ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue ent-core:SelfDirected ;
        sh:message "SDP-R-001: a self-directed insight must be delivered under the self-directed delivery model." ] ;
    sh:property [
        sh:path sdp:suggestsAction ;
        sh:not [ sh:in ( sdp:BuySecurity sdp:SellSecurity ) ] ;
        sh:message "SDP-R-001: a self-directed insight must not suggest buying or selling a security." ] .

# ---- SDP-R-002  Goal completeness ------------------------------------------------

sdp-rule:GoalCompletenessRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "goal completeness rule"@en ;
    ent-av:ruleIdentifier "SDP-R-002" ;
    ent-av:ruleStatement "Every financial goal has exactly one goal reference, one owning customer, one target amount in a single currency and one target date."@en ;
    ent-av:policySource "Digital planning data standard (placeholder ref DPS-GOAL-01)" ;
    ent-gov:hasRuleOwner sdp-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ;
    sh:targetClass sdp:FinancialGoal ;
    sh:message "SDP-R-002: a financial goal must be complete (reference, owner, target amount, target date)." ;
    sh:property [ sh:path sdp:hasGoalReference ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "SDP-R-002: a goal needs exactly one goal reference." ] ;
    sh:property [ sh:path sdp:hasGoalOwner ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ent-core:RetailCustomer ;
                  sh:message "SDP-R-002: a goal needs exactly one owning retail customer." ] ;
    sh:property [ sh:path sdp:hasTargetAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ent-ra:MonetaryAmountShape ;
                  sh:message "SDP-R-002: a goal needs exactly one target amount with amount and currency." ] ;
    sh:property [ sh:path sdp:hasTargetDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ;
                  sh:message "SDP-R-002: a goal needs exactly one target date." ] .

# ---- SDP-R-003  Life expectancy provenance ------------------------------------------

sdp-rule:LifeExpectancyProvenanceRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "life expectancy provenance rule"@en ;
    ent-av:ruleIdentifier "SDP-R-003" ;
    ent-av:ruleStatement "A life expectancy assumption must come from exactly one governed mortality table with a stated version."@en ;
    ent-av:policySource "Planning assumptions policy (placeholder ref PAP-03)" ;
    ent-gov:hasRuleOwner sdp-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:common-reference.mortality-tables ;
    sh:targetClass sdp:LifeExpectancyAssumption ;
    sh:message "SDP-R-003: life expectancy assumptions must cite one versioned mortality table." ;
    sh:property [ sh:path sdp:sourcedFromTable ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ent-core:MortalityTable ;
                  sh:message "SDP-R-003: cite exactly one mortality table." ] ;
    sh:property [ sh:path ( sdp:sourcedFromTable ent-core:tableVersion ) ; sh:minCount 1 ;
                  sh:message "SDP-R-003: the mortality table must state its version." ] ;
    sh:property [ sh:path sdp:assumedValue ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 50 ; sh:maxInclusive 120 ;
                  sh:message "SDP-R-003: life expectancy must be a single age between 50 and 120." ] .

# ---- SDP-R-007  Retirement scenario completeness ------------------------------------

sdp-rule:RetirementScenarioRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "retirement scenario rule"@en ;
    ent-av:ruleIdentifier "SDP-R-007" ;
    ent-av:ruleStatement "Every projection of a retirement goal must come from a scenario that uses a life expectancy assumption."@en ;
    ent-av:policySource "Planning assumptions policy (placeholder ref PAP-03)" ;
    ent-gov:hasRuleOwner sdp-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:common-reference.mortality-tables ;
    skos:editorialNote "SHACL-SPARQL used because the constraint spans projection -> goal type -> scenario -> assumption type."@en ;
    sh:targetClass sdp:GoalProjection ;
    sh:message "SDP-R-007: retirement projections need a scenario with a life expectancy assumption." ;
    sh:sparql [
        sh:message "SDP-R-007: this retirement projection's scenario has no life expectancy assumption." ;
        sh:prefixes <https://ontology.example.com/domain/rwpa/self-directed-planning/rules/> ;
        sh:select """
            SELECT $this WHERE {
              $this sdp:projectsGoal ?goal ; sdp:producedByScenario ?scenario .
              ?goal a sdp:RetirementGoal .
              FILTER NOT EXISTS { ?scenario sdp:usesAssumption ?a . ?a a sdp:LifeExpectancyAssumption . }
            }""" ] .

# ---- SDP-R-004  Health score validity ------------------------------------------------

sdp-rule:HealthScoreRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "financial health score rule"@en ;
    ent-av:ruleIdentifier "SDP-R-004" ;
    ent-av:ruleStatement "A financial health score is a single value from 0 to 100 for one customer, and records the model and model version that produced it."@en ;
    ent-av:policySource "Model risk management standard (placeholder ref MRM-07); control CTL-008" ;
    ent-gov:hasRuleOwner sdp-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-health-scores ;
    sh:targetClass sdp:FinancialHealthScore ;
    sh:message "SDP-R-004: health scores must be 0-100, for one customer, with model provenance." ;
    sh:node ent-ra:PercentageScoreShape , ent-ra:ModelProvenanceShape ;
    sh:property [ sh:path sdp:scoresCustomer ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ent-core:RetailCustomer ;
                  sh:message "SDP-R-004: a health score describes exactly one retail customer." ] .

# ---- SDP-R-005  Insight traceability -------------------------------------------------

sdp-rule:InsightTraceabilityRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "insight traceability rule"@en ;
    ent-av:ruleIdentifier "SDP-R-005" ;
    ent-av:ruleStatement "Every planning insight names its customer, its category and its customer-facing text, and records the model, model version and time that generated it, so it can be supervised and retained."@en ;
    ent-av:policySource "Communications supervision procedure (placeholder ref CSP-12); controls CTL-002, CTL-008" ;
    ent-gov:hasRuleOwner sdp-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics ;
    sh:targetClass sdp:PlanningInsight ;
    sh:message "SDP-R-005: insights must be traceable (customer, category, text, model provenance)." ;
    sh:node ent-ra:ModelProvenanceShape ;
    sh:property [ sh:path sdp:insightFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ent-core:RetailCustomer ;
                  sh:message "SDP-R-005: an insight is addressed to exactly one retail customer." ] ;
    sh:property [ sh:path sdp:hasInsightCategory ; sh:minCount 1 ; sh:class sdp:InsightCategory ;
                  sh:message "SDP-R-005: an insight needs a category." ] ;
    sh:property [ sh:path sdp:insightText ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 10 ;
                  sh:message "SDP-R-005: an insight needs its customer-facing text." ] .

# ---- SDP-R-006  Projection validity ------------------------------------------------------

sdp-rule:ProjectionValidityRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "projection validity rule"@en ;
    ent-av:ruleIdentifier "SDP-R-006" ;
    ent-av:ruleStatement "A goal projection projects one goal, comes from one scenario, has one projected amount and a probability of success between 0 and 1."@en ;
    ent-av:policySource "Digital planning data standard (placeholder ref DPS-PROJ-02)" ;
    ent-gov:hasRuleOwner sdp-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ;
    sh:targetClass sdp:GoalProjection ;
    sh:message "SDP-R-006: projections must be well-formed." ;
    sh:property [ sh:path sdp:projectsGoal ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sdp:FinancialGoal ] ;
    sh:property [ sh:path sdp:producedByScenario ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sdp:PlanningScenario ] ;
    sh:property [ sh:path sdp:hasProjectedAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:node ent-ra:MonetaryAmountShape ] ;
    sh:property [ sh:path sdp:probabilityOfSuccess ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                  sh:minInclusive 0 ; sh:maxInclusive 1 ;
                  sh:message "SDP-R-006: probability of success must be a decimal between 0 and 1." ] .
