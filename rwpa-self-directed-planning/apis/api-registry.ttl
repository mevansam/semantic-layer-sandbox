@prefix sdp:     <https://ontology.example.com/domain/rwpa/self-directed-planning/planning/> .
@prefix sdp-api: <https://ontology.example.com/domain/rwpa/self-directed-planning/apis/> .
@prefix sdp-m:   <https://ontology.example.com/domain/rwpa/self-directed-planning/governance/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix ent-av:  <https://ontology.example.com/governance/annotations/> .
@prefix ent-tax: <https://ontology.example.com/taxonomy/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Self-Directed Wealth Planning - DOMAIN API REGISTRY (owned by the API owner)
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/rwpa/self-directed-planning/apis/>
    a owl:Ontology ;
    rdfs:label "Self-Directed Wealth Planning - domain APIs"@en ;
    dct:abstract "Domain APIs for goals, plans, projections, health scores and insights, and the ontology concepts they serve."@en ;
    owl:versionIRI <https://ontology.example.com/domain/rwpa/self-directed-planning/apis/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

sdp-api:PlanningApi a ent-gov:DomainApi ;
    rdfs:label "Self-Directed Planning API"@en ;
    skos:definition "Create and read a customer's financial goals and self-directed plans, and read goal projections."@en ;
    ent-gov:apiSpecification "apis/planning-api.openapi.yaml"^^xsd:anyURI ;
    ent-gov:servesConcept sdp:FinancialGoal , sdp:SelfDirectedPlan , sdp:GoalProjection ;
    ent-gov:hasApiOwner sdp-m:ApiOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp-api:InsightsApi a ent-gov:DomainApi ;
    rdfs:label "Planning Insights API"@en ;
    skos:definition "Read a customer's financial health score and self-directed insights."@en ;
    ent-gov:apiSpecification "apis/insights-api.openapi.yaml"^^xsd:anyURI ;
    ent-gov:servesConcept sdp:FinancialHealthScore , sdp:SelfDirectedInsight ;
    ent-gov:hasApiOwner sdp-m:ApiOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics .
