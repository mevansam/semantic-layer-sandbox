@prefix ent-reg: <https://ontology.example.com/fibo-ext/registry/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# DOMAIN REGISTRY
#
# Reserves a namespace for each business domain of the capability map and lists
# the modules it publishes for reuse. Namespaces follow the folder layout
# (ADR-0005):  {base}domain/{business-domain}/{sub-domain}/
# A domain repository's CI fails unless its namespace is registered here (rule
# E2); a domain may import another domain's module only if it is listed as
# ent-gov:publishedModule (rule E3). How to register: docs/registering-a-domain.md
# -----------------------------------------------------------------------------

<https://ontology.example.com/fibo-ext/registry/>
    a owl:Ontology ;
    rdfs:label "Enterprise Domain Registry"@en ;
    dct:abstract "Registered business domains, their reserved namespaces, codes, repositories and published modules."@en ;
    owl:imports <https://ontology.example.com/governance/model/> ;
    owl:versionIRI <https://ontology.example.com/fibo-ext/registry/0.3.0/> ;
    owl:versionInfo "0.3.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

# ---- Retail Wealth Management (business domain with sub-domains) ------------------

ent-reg:rwm a ent-gov:DomainRegistration ;
    rdfs:label "Retail Wealth Management"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management> ;
    ent-gov:domainCode "rwm" ;
    ent-gov:namespace "https://ontology.example.com/domain/retail-wealth-management/"^^xsd:anyURI ;
    ent-gov:codeRepository "https://github.com/example-org/semantic-layer-sandbox/tree/main/domains/retail-wealth-management"^^xsd:anyURI ;
    ent-gov:registrationStatus "Provisional" ;
    dct:description "Parent namespace: business-domain umbrella ontology and parent manifest. Sub-domains are registered below."@en ;
    dct:created "2026-09-29"^^xsd:date .

ent-reg:rwm-pg a ent-gov:DomainRegistration ;
    rdfs:label "Retail Wealth Management - Planning and Guidance"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management/planning-and-guidance> ;
    ent-gov:domainCode "rwm-pg" ;
    ent-gov:namespace "https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/"^^xsd:anyURI ;
    ent-gov:codeRepository "https://github.com/example-org/semantic-layer-sandbox/tree/main/domains/retail-wealth-management/planning-and-guidance"^^xsd:anyURI ;
    # Published: other sub-domains (insights-and-analytics) and the business-domain umbrella build on it.
    ent-gov:publishedModule <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/planning/> ;
    ent-gov:registrationStatus "Provisional" ;
    dct:created "2026-09-29"^^xsd:date .

ent-reg:rwm-ia a ent-gov:DomainRegistration ;
    rdfs:label "Retail Wealth Management - Insights and Analytics"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management/insights-and-analytics> ;
    ent-gov:domainCode "rwm-ia" ;
    ent-gov:namespace "https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/"^^xsd:anyURI ;
    ent-gov:codeRepository "https://github.com/example-org/semantic-layer-sandbox/tree/main/domains/retail-wealth-management/insights-and-analytics"^^xsd:anyURI ;
    ent-gov:publishedModule <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/insights/> ;
    ent-gov:registrationStatus "Provisional" ;
    dct:created "2026-09-29"^^xsd:date .

# ---- Reserved (no repository yet) ------------------------------------------------------

ent-reg:pg-fa a ent-gov:DomainRegistration ;
    rdfs:label "Financial Assessments"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/planning-and-guidance/financial-assessments> ;
    ent-gov:domainCode "fa" ;
    ent-gov:namespace "https://ontology.example.com/domain/financial-assessments/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:description "Will take ownership of the financial health score, currently incubated in rwm-ia (assessments module)."@en ;
    dct:created "2026-09-28"^^xsd:date .

ent-reg:is-calc a ent-gov:DomainRegistration ;
    rdfs:label "Calculator Management"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/investment-servicing/calculator-management> ;
    ent-gov:domainCode "calc" ;
    ent-gov:namespace "https://ontology.example.com/domain/calculator-management/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:description "Provides the projection calculations used by Retail Wealth Management - Planning and Guidance."@en ;
    dct:created "2026-09-28"^^xsd:date .

ent-reg:cm-cust a ent-gov:DomainRegistration ;
    rdfs:label "Customer Management"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/customer-management/customer-management> ;
    ent-gov:domainCode "cust" ;
    ent-gov:namespace "https://ontology.example.com/domain/customer-management/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:description "Owning domain of enterprise-core RetailCustomer (ALN-001)."@en ;
    dct:created "2026-09-28"^^xsd:date .

ent-reg:oth-crd a ent-gov:DomainRegistration ;
    rdfs:label "Common Reference Data"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/other/common-reference-data> ;
    ent-gov:domainCode "crd" ;
    ent-gov:namespace "https://ontology.example.com/domain/common-reference-data/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:description "Owning domain of enterprise-core MortalityTable."@en ;
    dct:created "2026-09-28"^^xsd:date .
