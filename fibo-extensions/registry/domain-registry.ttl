@prefix ent-reg: <https://ontology.example.com/fibo-ext/registry/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix ent-dom: <https://ontology.example.com/capability/domain/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# DOMAIN REGISTRY
#
# Reserves a namespace for each business (sub-)domain and lists the modules it
# publishes for reuse. A domain repository's CI fails unless its namespace is
# registered here (rule E2), and a domain may import another domain's module
# only if it is listed as ent-gov:publishedModule (rule E3).
#
# How to register: docs/registering-a-domain.md
# -----------------------------------------------------------------------------

<https://ontology.example.com/fibo-ext/registry/>
    a owl:Ontology ;
    rdfs:label "Enterprise Domain Registry"@en ;
    dct:abstract "Registered business domains and sub-domains, their reserved namespaces, codes, repositories and published modules."@en ;
    owl:imports <https://ontology.example.com/governance/model/> ;
    owl:versionIRI <https://ontology.example.com/fibo-ext/registry/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

ent-reg:rwpa-sdp a ent-gov:DomainRegistration ;
    rdfs:label "Self-Directed Wealth Planning, Insights & Analytics"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/retail-wealth-planning-and-advisory/self-directed-wealth-planning-insights-and-analytics> ;
    ent-gov:domainCode "rwpa-sdp" ;
    ent-gov:namespace "https://ontology.example.com/domain/rwpa/self-directed-planning/"^^xsd:anyURI ;
    ent-gov:codeRepository "https://github.com/example-org/rwpa-self-directed-planning"^^xsd:anyURI ;
    ent-gov:publishedModule <https://ontology.example.com/domain/rwpa/self-directed-planning/planning/> ;
    ent-gov:registrationStatus "Provisional" ;
    dct:created "2026-09-28"^^xsd:date .

# Reserved for the sibling sub-domain (not yet created from the template):
ent-reg:rwpa-adv a ent-gov:DomainRegistration ;
    rdfs:label "Advised Planning & Advice"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/retail-wealth-planning-and-advisory/advised-planning-and-advice> ;
    ent-gov:domainCode "rwpa-adv" ;
    ent-gov:namespace "https://ontology.example.com/domain/rwpa/advised-planning/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:created "2026-09-28"^^xsd:date .
