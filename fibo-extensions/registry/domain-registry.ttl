@prefix ent-reg: <https://ontology.example.com/fibo-ext/registry/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# DOMAIN REGISTRY
#
# Reserves a namespace for each business domain of the capability map and lists
# the modules it publishes for reuse. Namespaces follow the capability map
# (ADR-0004):  {base}domain/{ontology-domain}/{business-domain}/
# A domain repository's CI fails unless its namespace is registered here (rule
# E2); a domain may import another domain's module only if it is listed as
# ent-gov:publishedModule (rule E3). How to register: docs/registering-a-domain.md
# -----------------------------------------------------------------------------

<https://ontology.example.com/fibo-ext/registry/>
    a owl:Ontology ;
    rdfs:label "Enterprise Domain Registry"@en ;
    dct:abstract "Registered business domains, their reserved namespaces, codes, repositories and published modules."@en ;
    owl:imports <https://ontology.example.com/governance/model/> ;
    owl:versionIRI <https://ontology.example.com/fibo-ext/registry/0.2.0/> ;
    owl:versionInfo "0.2.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

# ---- Planning and Guidance -------------------------------------------------------

ent-reg:pg-fpm a ent-gov:DomainRegistration ;
    rdfs:label "Financial Plan Management"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/planning-and-guidance/financial-plan-management> ;
    ent-gov:domainCode "pg-fpm" ;
    ent-gov:namespace "https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/"^^xsd:anyURI ;
    ent-gov:codeRepository "https://github.com/example-org/planning-and-guidance-financial-plan-management"^^xsd:anyURI ;
    ent-gov:publishedModule <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/> ;
    ent-gov:registrationStatus "Provisional" ;
    dct:created "2026-09-28"^^xsd:date .

ent-reg:pg-fa a ent-gov:DomainRegistration ;
    rdfs:label "Financial Assessments"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/planning-and-guidance/financial-assessments> ;
    ent-gov:domainCode "pg-fa" ;
    ent-gov:namespace "https://ontology.example.com/domain/planning-and-guidance/financial-assessments/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:description "Will take ownership of the financial health score, currently incubated in pg-fpm (assessments module)."@en ;
    dct:created "2026-09-28"^^xsd:date .

# ---- Investment Servicing -----------------------------------------------------------

ent-reg:is-rwm a ent-gov:DomainRegistration ;
    rdfs:label "Retail Wealth Management"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management> ;
    ent-gov:domainCode "is-rwm" ;
    ent-gov:namespace "https://ontology.example.com/domain/investment-servicing/retail-wealth-management/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:description "Advised side of the advice boundary (alignment decision ALN-002)."@en ;
    dct:created "2026-09-28"^^xsd:date .

ent-reg:is-calc a ent-gov:DomainRegistration ;
    rdfs:label "Calculator Management"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/investment-servicing/calculator-management> ;
    ent-gov:domainCode "is-calc" ;
    ent-gov:namespace "https://ontology.example.com/domain/investment-servicing/calculator-management/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:description "Provides the projection calculations used by Financial Plan Management."@en ;
    dct:created "2026-09-28"^^xsd:date .

# ---- Customer Management / Other ---------------------------------------------------------

ent-reg:cm-cust a ent-gov:DomainRegistration ;
    rdfs:label "Customer Management"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/customer-management/customer-management> ;
    ent-gov:domainCode "cm-cust" ;
    ent-gov:namespace "https://ontology.example.com/domain/customer-management/customer-management/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:description "Owning domain of enterprise-core RetailCustomer (ALN-001)."@en ;
    dct:created "2026-09-28"^^xsd:date .

ent-reg:oth-crd a ent-gov:DomainRegistration ;
    rdfs:label "Common Reference Data"@en ;
    ent-gov:registersDomain <https://ontology.example.com/capability/domain/other/common-reference-data> ;
    ent-gov:domainCode "oth-crd" ;
    ent-gov:namespace "https://ontology.example.com/domain/other/common-reference-data/"^^xsd:anyURI ;
    ent-gov:registrationStatus "Reserved" ;
    dct:description "Owning domain of enterprise-core MortalityTable."@en ;
    dct:created "2026-09-28"^^xsd:date .
