@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .

# -----------------------------------------------------------------------------
# UMBRELLA ONTOLOGY - ontology domain "Investment Servicing" (capability map)
# Imports the business-domain umbrellas / published modules of its domains.
# Consumers import this; domains never do (rule E3). IRIs: {base}ontology-domain/{od}/
# -----------------------------------------------------------------------------

<https://ontology.example.com/ontology-domain/investment-servicing/>
    a owl:Ontology ;
    rdfs:label "Investment Servicing ontology domain"@en ;
    dct:abstract "Umbrella for the Investment Servicing ontology domain. Retail Wealth Management (financial planning, insights and analytics) is the first business domain with published modules."@en ;
    dct:subject <https://ontology.example.com/capability/ontology-domain/investment-servicing> ;
    owl:imports <https://ontology.example.com/domain/retail-wealth-management/> ;
    owl:versionIRI <https://ontology.example.com/ontology-domain/investment-servicing/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .
