@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .

# -----------------------------------------------------------------------------
# UMBRELLA ONTOLOGY - ontology domain "Planning and Guidance" (capability map)
#
# Imports the PUBLISHED modules of the ontology domain's business domains, in
# the same way FIBO's AllFND works. Consumers that need the whole ontology
# domain import this; domains never import it (they import only what they
# need, rule E3). Add a line when a domain publishes a module (registry).
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/planning-and-guidance/>
    a owl:Ontology ;
    rdfs:label "Planning and Guidance ontology domain"@en ;
    dct:abstract "Umbrella for the Planning and Guidance ontology domain: Financial Plan Management (published), Financial Assessments, Household Management, Benefits Management and other domains as they publish modules."@en ;
    dct:subject <https://ontology.example.com/capability/ontology-domain/planning-and-guidance> ;
    owl:imports <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/> ;
    owl:versionIRI <https://ontology.example.com/domain/planning-and-guidance/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .
