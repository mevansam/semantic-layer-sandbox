@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix ent-av:  <https://ontology.example.com/governance/annotations/> .
@prefix ent-aln: <https://ontology.example.com/governance/alignment/> .
@prefix ent-dom: <https://ontology.example.com/capability/domain/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Cross-domain alignment register (enterprise-owned decisions).
# Axioms that implement "Specialization" or "Equivalent" decisions live in
# fibo-extensions/ontology/alignment/; the register records WHY and WHO agreed.
# -----------------------------------------------------------------------------

<https://ontology.example.com/governance/alignment/>
    a owl:Ontology ;
    rdfs:label "Cross-domain Alignment Register"@en ;
    dct:abstract "Recorded decisions on how terms owned by different business domains relate."@en ;
    owl:imports <https://ontology.example.com/governance/model/> ;
    owl:versionIRI <https://ontology.example.com/governance/alignment/0.2.0/> ;
    owl:versionInfo "0.2.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

ent-aln:ALN-001 a ent-gov:AlignmentDecision ;
    rdfs:label "Retail customer is shared enterprise-core meaning"@en ;
    skos:definition "Retail wealth management and customer management both need 'the retail person we serve'. Agreed as one concept, promoted to enterprise core as ent-core:RetailCustomer (a FIBO Customer). Customer Management remains the owning domain."@en ;
    ent-gov:alignsTerm <https://ontology.example.com/fibo-ext/core/RetailCustomer> ;
    ent-gov:alignmentType ent-gov:Equivalent ;
    ent-gov:consultedDomain ent-dom:customer-management\/customer-management ,
        ent-dom:investment-servicing\/retail-wealth-management ;
    prov:generatedAtTime "2026-09-28T00:00:00Z"^^xsd:dateTime ;
    ent-av:changeNote "Seed decision created with the sandbox baseline."@en .

ent-aln:ALN-002 a ent-gov:AlignmentDecision ;
    rdfs:label "Self-directed insight is not an advice recommendation"@en ;
    skos:definition "A self-directed planning insight (educational, non-personalized) and an advised-planning recommendation (personalized, supervised) look alike but are different regulated activities. They must never be treated as equivalent; agents keep them distinct (CTL-007). The boundary now runs inside Retail Wealth Management: the self-directed side is the Insights and Analytics sub-domain; the advised-side term is to be created by a future advice sub-domain of Retail Wealth Management."@en ;
    ent-gov:alignsTerm <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/insights/SelfDirectedInsight> ;
    ent-gov:alignmentType ent-gov:RelatedNotEquivalent ;
    ent-gov:consultedDomain ent-dom:investment-servicing\/retail-wealth-management ,
        <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management/insights-and-analytics> ;
    prov:generatedAtTime "2026-09-28T00:00:00Z"^^xsd:dateTime .
