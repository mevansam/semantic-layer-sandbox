@prefix {{ prefix }}:      <{{ base_iri }}domain/{{ namespace_path }}/{{ module_name }}/> .
@prefix {{ prefix }}-data: <{{ base_iri }}domain/{{ namespace_path }}/stewardship/> .
@prefix {{ prefix }}-rule: <{{ base_iri }}domain/{{ namespace_path }}/rules/> .
@prefix {{ prefix }}-m:    <{{ base_iri }}domain/{{ namespace_path }}/governance/> .
@prefix ent-gov: <{{ base_iri }}governance/model/> .
@prefix ent-av:  <{{ base_iri }}governance/annotations/> .
@prefix ent-tax: <{{ base_iri }}taxonomy/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix dprod: <https://ekgf.github.io/dprod/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# -----------------------------------------------------------------------------
# {{ domain_name }} - DATA STEWARDSHIP (owned by the data steward)
# Data products (DCAT / EKGF DPROD) and critical data elements.
# Standard: docs/standards/04-apis-data-records.md
# -----------------------------------------------------------------------------

<{{ base_iri }}domain/{{ namespace_path }}/stewardship/>
    a owl:Ontology ;
    rdfs:label "{{ domain_name }} - data stewardship"@en ;
    dct:abstract "Data products and critical data elements of the {{ domain_name }} business domain, with their stewards and quality rules."@en ;
    owl:versionIRI <{{ base_iri }}domain/{{ namespace_path }}/stewardship/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

{{ prefix }}-data:{{ seed_class }}DataProduct a dcat:Dataset , dprod:DataProduct ;
    rdfs:label "{{ seed_class_label }} data product"@en ;
    dct:description "Placeholder data product publishing {{ seed_class_label }} records."@en ;
    ent-gov:servesConcept {{ prefix }}:{{ seed_class }} ;
    ent-gov:hasDataSteward {{ prefix }}-m:DataStewardRole ;
    ent-av:governedBy ent-tax:{{ seed_class_anchor }} .

{{ prefix }}-data:ReferenceCodeCDE a ent-gov:CriticalDataElement ;
    rdfs:label "{{ seed_class_label }} reference code"@en ;
    ent-gov:elementOf {{ prefix }}:hasReferenceCode ;
    ent-gov:hasDataSteward {{ prefix }}-m:DataStewardRole ;
    ent-gov:hasQualityRule {{ prefix }}-rule:ReferenceCodeRule .
