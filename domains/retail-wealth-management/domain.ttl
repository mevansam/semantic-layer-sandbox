@prefix rwm-p: <https://ontology.example.com/domain/retail-wealth-management/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Retail Wealth Management - PARENT LAYER (business domain with sub-domains)
#
# Extension points at business-domain level:
#   1. UMBRELLA  - imports each sub-domain's PUBLISHED module. `semtool verify`
#                  reasons over it, so the sub-domains are checked to cohere
#                  with each other and with FIBO.
#   2. MANIFEST  - the business-domain owner and the sub-domains it includes.
#                  Overlaps between sub-domains are settled here, before they
#                  need an enterprise alignment decision.
# Add a sub-domain: domains/domain-template/scripts/new_domain.py, then add it
# to ent-gov:includesSubDomain and (once published) to owl:imports below.
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/retail-wealth-management/>
    a owl:Ontology ;
    rdfs:label "Retail Wealth Management"@en ;
    dct:abstract "Umbrella ontology of the Retail Wealth Management business domain (Investment Servicing ontology domain): imports the published modules of its sub-domains."@en ;
    owl:imports <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/planning/> ,
        <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/insights/> ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

rwm-p:ParentManifest a ent-gov:ParentDomainManifest ;
    rdfs:label "Retail Wealth Management parent manifest"@en ;
    ent-gov:describesDomain <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management> ;
    ent-gov:namespace "https://ontology.example.com/domain/retail-wealth-management/"^^xsd:anyURI ;
    ent-gov:hasDomainOwner rwm-p:DomainOwnerRole ;
    ent-gov:includesSubDomain <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management/planning-and-guidance> ,
        <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management/insights-and-analytics> .

rwm-p:DomainOwnerRole a ent-gov:DomainOwner ;
    rdfs:label "Retail Wealth Management business-domain owner"@en ;
    ent-gov:accountableFor ent-gov:Meaning ;
    ent-gov:heldBy "Head of Retail Wealth Management (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-domain-owners" .
