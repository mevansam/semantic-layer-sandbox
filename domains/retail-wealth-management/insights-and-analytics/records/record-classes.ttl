@prefix dct:             <http://purl.org/dc/terms/> .
@prefix ent-av:          <https://ontology.example.com/governance/annotations/> .
@prefix ent-gov:         <https://ontology.example.com/governance/model/> .
@prefix ent-tax:         <https://ontology.example.com/taxonomy/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix ia:              <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/insights/> .
@prefix ia-m:            <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/governance/> .
@prefix ia-rec:          <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/records/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/records/>
    a owl:Ontology ;
    rdfs:label "Insights and Analytics - record classes"@en ;
    dct:abstract "Records created by insights: self-directed insights delivered to customers."@en ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/records/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

ia-rec:InsightRecord a ent-gov:RecordClass ;
    rdfs:label "delivered insight record"@en ;
    skos:definition "Record of each self-directed insight delivered to a customer, with its text, category, suggested action, model provenance and the rule-pack result, retained as a communication with the customer."@en ;
    ent-gov:recordOf ia:SelfDirectedInsight ;
    ent-gov:retentionPeriod "P6Y"^^xsd:duration ;
    ent-gov:retentionTrigger "delivery of the insight to the customer" ;
    ent-gov:legalHoldApplicable true ;
    ent-gov:dispositionMethod "secure deletion after retention unless under legal hold" ;
    ent-gov:storageRequirement "non-rewriteable, non-erasable storage (placeholder - confirm)" ;
    ent-gov:hasRecordsOwner ia-m:RecordsOwnerRole ;
    ent-av:regulatoryCitation "PLACEHOLDER: SEC Rule 17a-4 / FINRA Rules 2210 and 4511 (communications with the public) - confirm applicability and period with Legal & Compliance" ;
    ent-av:governedBy ent-tax:legal-risk-compliance-and-surveillance.enterprise-risk.content-retention-and-management .
