@prefix dct:             <http://purl.org/dc/terms/> .
@prefix ent-av:          <https://ontology.example.com/governance/annotations/> .
@prefix ent-gov:         <https://ontology.example.com/governance/model/> .
@prefix ent-tax:         <https://ontology.example.com/taxonomy/> .
@prefix fa:              <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/assessments/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix ia:              <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/insights/> .
@prefix ia-api:          <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/apis/> .
@prefix ia-m:            <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/governance/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/apis/>
    a owl:Ontology ;
    rdfs:label "Insights and Analytics - domain APIs"@en ;
    dct:abstract "Domain APIs for financial health scores and self-directed insights, and the ontology concepts they serve."@en ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/apis/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

ia-api:InsightsApi a ent-gov:DomainApi ;
    rdfs:label "Planning Insights API"@en ;
    skos:definition "Read a customer's financial health score and self-directed insights."@en ;
    ent-gov:apiSpecification "apis/insights-api.openapi.yaml"^^xsd:anyURI ;
    ent-gov:servesConcept fa:FinancialHealthScore , ia:SelfDirectedInsight ;
    ent-gov:hasApiOwner ia-m:ApiOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics .
