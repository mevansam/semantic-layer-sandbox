@prefix dct:             <http://purl.org/dc/terms/> .
@prefix ent-av:          <https://ontology.example.com/governance/annotations/> .
@prefix ent-core:        <https://ontology.example.com/fibo-ext/core/> .
@prefix ent-gov:         <https://ontology.example.com/governance/model/> .
@prefix ent-ra:          <https://ontology.example.com/fabric/assets/> .
@prefix ent-tax:         <https://ontology.example.com/taxonomy/> .
@prefix fa:              <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/assessments/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix ia:              <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/insights/> .
@prefix ia-m:            <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/governance/> .
@prefix ia-rule:         <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/rules/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:              <http://www.w3.org/ns/shacl#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

# Insights and Analytics - BUSINESS RULES (owned by the rule owner). IA-R-NNN.

<https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/rules/>
    a owl:Ontology ;
    rdfs:label "Insights and Analytics - business rules"@en ;
    dct:abstract "Executable business rules for self-directed insights (including the advice boundary) and financial health scores."@en ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/rules/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

# ---- IA-R-001  Advice boundary --------------------------------------------------
ia-rule:AdviceBoundaryRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "advice boundary rule"@en ;
    ent-av:ruleIdentifier "IA-R-001" ;
    ent-av:ruleStatement "A self-directed insight must be delivered under the self-directed delivery model and must not recommend buying or selling a specific security; such recommendations are personalized advice and belong to the advised channel."@en ;
    ent-av:policySource "Retail advice boundary policy (placeholder ref RP-ADV-004); alignment decision ALN-002" ;
    ent-gov:hasRuleOwner ia-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:products-and-services.personalized-planning-and-guidance-services ;
    ent-av:agentGuidance "Enforced at runtime by rule pack rwm_ia_advice_boundary_rulepack (CTL-005). If violated, block delivery and offer to connect the customer with the advised channel."@en ;
    sh:targetClass ia:SelfDirectedInsight ;
    sh:message "IA-R-001: a self-directed insight must not recommend buying or selling a specific security." ;
    sh:property [
        sh:path ent-core:hasDeliveryModel ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue ent-core:SelfDirected ;
        sh:message "IA-R-001: a self-directed insight must be delivered under the self-directed delivery model." ] ;
    sh:property [
        sh:path ia:suggestsAction ;
        sh:not [ sh:in ( ia:BuySecurity ia:SellSecurity ) ] ;
        sh:message "IA-R-001: a self-directed insight must not suggest buying or selling a security." ] .

# ---- IA-R-002  Health score validity ------------------------------------------------
ia-rule:HealthScoreRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "financial health score rule"@en ;
    ent-av:ruleIdentifier "IA-R-002" ;
    ent-av:ruleStatement "A financial health score is a single value from 0 to 100 for one customer, and records the model and model version that produced it."@en ;
    ent-av:policySource "Model risk management standard (placeholder ref MRM-07); control CTL-008" ;
    ent-gov:hasRuleOwner ia-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-health-scores ;
    sh:targetClass fa:FinancialHealthScore ;
    sh:message "IA-R-002: health scores must be 0-100, for one customer, with model provenance." ;
    sh:node ent-ra:PercentageScoreShape , ent-ra:ModelProvenanceShape ;
    sh:property [ sh:path fa:scoresCustomer ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ent-core:RetailCustomer ;
                  sh:message "IA-R-002: a health score describes exactly one retail customer." ] .

# ---- IA-R-003  Insight traceability -------------------------------------------------
ia-rule:InsightTraceabilityRule
    a sh:NodeShape , ent-gov:BusinessRule ;
    rdfs:label "insight traceability rule"@en ;
    ent-av:ruleIdentifier "IA-R-003" ;
    ent-av:ruleStatement "Every planning insight names its customer, its category and its customer-facing text, and records the model, model version and time that generated it, so it can be supervised and retained."@en ;
    ent-av:policySource "Communications supervision procedure (placeholder ref CSP-12); controls CTL-002, CTL-008" ;
    ent-gov:hasRuleOwner ia-m:RuleOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics ;
    sh:targetClass ia:PlanningInsight ;
    sh:message "IA-R-003: insights must be traceable (customer, category, text, model provenance)." ;
    sh:node ent-ra:ModelProvenanceShape ;
    sh:property [ sh:path ia:insightFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ent-core:RetailCustomer ;
                  sh:message "IA-R-003: an insight is addressed to exactly one retail customer." ] ;
    sh:property [ sh:path ia:hasInsightCategory ; sh:minCount 1 ; sh:class ia:InsightCategory ;
                  sh:message "IA-R-003: an insight needs a category." ] ;
    sh:property [ sh:path ia:insightText ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 10 ;
                  sh:message "IA-R-003: an insight needs its customer-facing text." ] .
