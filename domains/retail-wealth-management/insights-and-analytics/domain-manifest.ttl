@prefix ia-m: <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/governance/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix ent-tax: <https://ontology.example.com/taxonomy/> .
@prefix ent-cap: <https://ontology.example.com/capability/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# DOMAIN MANIFEST - Insights and Analytics
#
# The machine-readable statement of what this domain is accountable for and
# who holds each accountability. CI validates it (ent-ms:DomainManifestShape)
# and generates CODEOWNERS from it. Keep role holders current.
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/governance/>
    a owl:Ontology ;
    rdfs:label "Insights and Analytics - domain governance"@en ;
    dct:abstract "Domain manifest, accountable roles, knowledge collections and execution models of the Insights and Analytics business domain."@en ;
    owl:imports <https://ontology.example.com/governance/model/> ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/governance/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

ia-m:Manifest a ent-gov:DomainManifest ;
    rdfs:label "Insights and Analytics domain manifest"@en ;
    ent-gov:describesDomain <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management/insights-and-analytics> ;
    ent-gov:namespace "https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/"^^xsd:anyURI ;
    ent-gov:codeRepository "https://github.com/example-org/semantic-layer-sandbox"^^xsd:anyURI ;
    ent-gov:hasOntologyModule <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/insights/> ,
        <https://ontology.example.com/domain/retail-wealth-management/insights-and-analytics/assessments/> ;
    ent-gov:dependsOnSubDomain <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management/financial-planning> ;
    ent-gov:anchoredTo ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics ;
    ent-gov:anchoredTo ent-tax:customers.customer-intelligence-and-analytics.customer-financial-health-scores ;
    ent-gov:realizesCapability ent-cap:financial-planning.planning-insights-and-analytics ;
    ent-gov:hasDomainOwner ia-m:DomainOwnerRole ;
    ent-gov:hasRuleOwner ia-m:RuleOwnerRole ;
    ent-gov:hasApiOwner ia-m:ApiOwnerRole ;
    ent-gov:hasDataSteward ia-m:DataStewardRole ;
    ent-gov:hasRecordsOwner ia-m:RecordsOwnerRole ;
    dct:created "2026-09-29"^^xsd:date .

# ---- Accountable roles (MEANING, RULES, APIs, DATA, RECORDS) -------------------

ia-m:DomainOwnerRole a ent-gov:DomainOwner ;
    rdfs:label "Insights and Analytics domain owner"@en ;
    ent-gov:accountableFor ent-gov:Meaning ;
    ent-gov:heldBy "Head of Planning Insights & Analytics (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-ia-domain-owners" .

ia-m:RuleOwnerRole a ent-gov:RuleOwner ;
    rdfs:label "Insights and Analytics rule owner"@en ;
    ent-gov:accountableFor ent-gov:Rules ;
    ent-gov:heldBy "Insights Rules & Conduct Lead (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-ia-rule-owners" .

ia-m:ApiOwnerRole a ent-gov:ApiOwner ;
    rdfs:label "Insights and Analytics API owner"@en ;
    ent-gov:accountableFor ent-gov:Apis ;
    ent-gov:heldBy "Insights Platform Product Owner (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-ia-api-owners" .

ia-m:DataStewardRole a ent-gov:DataSteward ;
    rdfs:label "Insights and Analytics data steward"@en ;
    ent-gov:accountableFor ent-gov:Data ;
    ent-gov:heldBy "Insights Data Steward (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-ia-data-stewards" .

ia-m:RecordsOwnerRole a ent-gov:RecordsOwner ;
    rdfs:label "Insights and Analytics records owner"@en ;
    ent-gov:accountableFor ent-gov:Records ;
    ent-gov:heldBy "Wealth Records Manager (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-records" .

# Enterprise role referenced by this domain's risk assessments (approver, not owner)
ia-m:AIRiskApprover a ent-gov:AIRiskOwner ;
    rdfs:label "AI risk approver for Insights and Analytics"@en ;
    ent-gov:accountableFor ent-gov:AIRiskAndControls ;
    ent-gov:heldBy "AI Risk Office (placeholder)" ;
    ent-gov:reviewTeam "@example-org/ai-risk-office" .
