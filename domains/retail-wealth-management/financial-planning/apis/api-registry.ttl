@prefix dct:             <http://purl.org/dc/terms/> .
@prefix ent-av:          <https://ontology.example.com/governance/annotations/> .
@prefix ent-gov:         <https://ontology.example.com/governance/model/> .
@prefix ent-tax:         <https://ontology.example.com/taxonomy/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix fp:              <https://ontology.example.com/domain/retail-wealth-management/financial-planning/planning/> .
@prefix fp-api:          <https://ontology.example.com/domain/retail-wealth-management/financial-planning/apis/> .
@prefix fp-m:            <https://ontology.example.com/domain/retail-wealth-management/financial-planning/governance/> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.example.com/domain/retail-wealth-management/financial-planning/apis/>
    a owl:Ontology ;
    rdfs:label "Financial Planning - domain APIs"@en ;
    dct:abstract "Domain APIs for goals, plans and goal projections, and the ontology concepts they serve."@en ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/financial-planning/apis/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

fp-api:PlanningApi a ent-gov:DomainApi ;
    rdfs:label "Self-Directed Planning API"@en ;
    skos:definition "Create and read a customer's financial goals and self-directed plans, and read goal projections."@en ;
    ent-gov:apiSpecification "apis/planning-api.openapi.yaml"^^xsd:anyURI ;
    ent-gov:servesConcept fp:FinancialGoal , fp:SelfDirectedPlan , fp:GoalProjection ;
    ent-gov:hasApiOwner fp-m:ApiOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .
