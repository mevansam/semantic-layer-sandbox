@prefix fp-m:    <https://ontology.example.com/domain/retail-wealth-management/financial-planning/governance/> .
@prefix fp-rule: <https://ontology.example.com/domain/retail-wealth-management/financial-planning/rules/> .
@prefix fp-proc: <https://ontology.example.com/domain/retail-wealth-management/financial-planning/processes/> .
@prefix ent-fab: <https://ontology.example.com/fabric/model/> .
@prefix ent-ctl: <https://ontology.example.com/governance/controls/> .
@prefix ent-av:  <https://ontology.example.com/governance/annotations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Financial Planning - PUBLISHED EXECUTION MODELS
# Files are named after the tool: execution-models/{queries,schemas}/<toolName>.*
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/retail-wealth-management/financial-planning/governance/execution-models/>
    a owl:Ontology ;
    rdfs:label "Financial Planning - execution models"@en ;
    dct:abstract "Goal-progress query tool published by Financial Planning for AI agents."@en ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/financial-planning/governance/execution-models/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

fp-m:GoalProgressTool a ent-fab:QueryTool ;
    rdfs:label "goal progress tool"@en ;
    skos:definition "Returns a goal's target, latest projection, probability of success, the scenario's assumptions (with mortality-table provenance) and the rules that govern goals, for a goal reference."@en ;
    ent-fab:toolName "rwm_fp_goal_progress" ;
    ent-fab:artifactPath "execution-models/queries/rwm_fp_goal_progress.rq" ;
    ent-fab:inputSchemaPath "execution-models/schemas/rwm_fp_goal_progress.schema.json" ;
    ent-fab:derivedFromRule fp-rule:GoalCompletenessRule , fp-rule:ProjectionValidityRule ;
    ent-fab:implementsProcess fp-proc:GoalPlanningCycle ;
    ent-fab:groundedIn fp-m:Collection ;
    ent-fab:subjectToControl ent-ctl:CTL-006 , ent-ctl:CTL-002 , ent-ctl:CTL-004 ;
    ent-fab:hasRiskAssessment fp-m:GoalProgressRiskAssessment ;
    ent-av:agentGuidance "Only call for the authenticated customer's own goals. Present probability of success as an estimate and always list the assumptions returned."@en .

fp-m:GoalProgressRiskAssessment a ent-ctl:RiskAssessment ;
    rdfs:label "AI risk assessment - goal progress tool"@en ;
    ent-ctl:assesses fp-m:GoalProgressTool ;
    ent-ctl:identifiedRisk ent-ctl:RSK-001 , ent-ctl:RSK-003 ;
    ent-ctl:residualRiskRating ent-ctl:Low ;
    ent-ctl:approvedBy fp-m:AIRiskApprover ;
    ent-ctl:assessmentDate "2026-09-29"^^xsd:date .
