# Query tool: rwm_fp_goal_progress
# Input: $goalReference (JSON Schema: ../schemas/rwm_fp_goal_progress.schema.json). The runtime binds
# the input as a typed literal via VALUES; never concatenate user text into the query.
# Output: one row per assumption; goal/projection columns repeat. Cite goal and rule IRIs (CTL-002).
PREFIX fp: <https://ontology.example.com/domain/retail-wealth-management/financial-planning/planning/>
PREFIX ent-core: <https://ontology.example.com/fibo-ext/core/>
PREFIX ent-av: <https://ontology.example.com/governance/annotations/>
PREFIX fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?goal ?goalReference ?targetAmount ?targetDate ?projectedAmount ?probabilityOfSuccess
       ?assumption ?assumedValue ?mortalityTable ?tableVersion ?governingRules
WHERE {
  VALUES ?goalReference { $goalReference }
  ?goal fp:hasGoalReference ?goalReference ;
        fp:hasTargetDate ?targetDate ;
        fp:hasTargetAmount/fibo-fnd-acc-cur:hasAmount ?targetAmount .
  OPTIONAL {
    ?projection fp:projectsGoal ?goal ;
                fp:probabilityOfSuccess ?probabilityOfSuccess ;
                fp:hasProjectedAmount/fibo-fnd-acc-cur:hasAmount ?projectedAmount ;
                fp:producedByScenario ?scenario .
    OPTIONAL {
      ?scenario fp:usesAssumption ?a .
      ?a rdfs:label ?assumption ; fp:assumedValue ?assumedValue .
      OPTIONAL { ?a fp:sourcedFromTable ?t . ?t rdfs:label ?mortalityTable ; ent-core:tableVersion ?tableVersion . }
    }
  }
  {
    SELECT (GROUP_CONCAT(DISTINCT ?rid; separator=", ") AS ?governingRules) WHERE {
      ?rule sh:targetClass fp:FinancialGoal ; ent-av:ruleIdentifier ?rid .
    }
  }
}
ORDER BY ?assumption
