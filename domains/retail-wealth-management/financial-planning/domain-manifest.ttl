@prefix fp-m: <https://ontology.example.com/domain/retail-wealth-management/financial-planning/governance/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix ent-tax: <https://ontology.example.com/taxonomy/> .
@prefix ent-cap: <https://ontology.example.com/capability/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# DOMAIN MANIFEST - Financial Planning
#
# The machine-readable statement of what this domain is accountable for and
# who holds each accountability. CI validates it (ent-ms:DomainManifestShape)
# and generates CODEOWNERS from it. Keep role holders current.
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/retail-wealth-management/financial-planning/governance/>
    a owl:Ontology ;
    rdfs:label "Financial Planning - domain governance"@en ;
    dct:abstract "Domain manifest, accountable roles, knowledge collections and execution models of the Financial Planning business domain."@en ;
    owl:imports <https://ontology.example.com/governance/model/> ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/financial-planning/governance/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

fp-m:Manifest a ent-gov:DomainManifest ;
    rdfs:label "Financial Planning domain manifest"@en ;
    ent-gov:describesDomain <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management/financial-planning> ;
    ent-gov:namespace "https://ontology.example.com/domain/retail-wealth-management/financial-planning/"^^xsd:anyURI ;
    ent-gov:codeRepository "https://github.com/example-org/semantic-layer-sandbox"^^xsd:anyURI ;
    ent-gov:hasOntologyModule <https://ontology.example.com/domain/retail-wealth-management/financial-planning/planning/> ;
    ent-gov:anchoredTo ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ;
    ent-gov:anchoredTo ent-tax:products-and-services.planning-and-guidance-services ;
    ent-gov:realizesCapability ent-cap:financial-planning.goal-based-planning ;
    ent-gov:realizesCapability ent-cap:financial-planning.retirement-income-projection ;
    ent-gov:hasDomainOwner fp-m:DomainOwnerRole ;
    ent-gov:hasRuleOwner fp-m:RuleOwnerRole ;
    ent-gov:hasApiOwner fp-m:ApiOwnerRole ;
    ent-gov:hasDataSteward fp-m:DataStewardRole ;
    ent-gov:hasRecordsOwner fp-m:RecordsOwnerRole ;
    dct:created "2026-09-29"^^xsd:date .

# ---- Accountable roles (MEANING, RULES, APIs, DATA, RECORDS) -------------------

fp-m:DomainOwnerRole a ent-gov:DomainOwner ;
    rdfs:label "Financial Planning domain owner"@en ;
    ent-gov:accountableFor ent-gov:Meaning ;
    ent-gov:heldBy "Head of Digital Financial Planning (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-fp-domain-owners" .

fp-m:RuleOwnerRole a ent-gov:RuleOwner ;
    rdfs:label "Financial Planning rule owner"@en ;
    ent-gov:accountableFor ent-gov:Rules ;
    ent-gov:heldBy "Financial Planning Rules Lead (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-fp-rule-owners" .

fp-m:ApiOwnerRole a ent-gov:ApiOwner ;
    rdfs:label "Financial Planning API owner"@en ;
    ent-gov:accountableFor ent-gov:Apis ;
    ent-gov:heldBy "Planning Platform Product Owner (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-fp-api-owners" .

fp-m:DataStewardRole a ent-gov:DataSteward ;
    rdfs:label "Financial Planning data steward"@en ;
    ent-gov:accountableFor ent-gov:Data ;
    ent-gov:heldBy "Planning Data Steward (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-fp-data-stewards" .

fp-m:RecordsOwnerRole a ent-gov:RecordsOwner ;
    rdfs:label "Financial Planning records owner"@en ;
    ent-gov:accountableFor ent-gov:Records ;
    ent-gov:heldBy "Wealth Records Manager (placeholder)" ;
    ent-gov:reviewTeam "@example-org/rwm-records" .

# Enterprise role referenced by this domain's risk assessments (approver, not owner)
fp-m:AIRiskApprover a ent-gov:AIRiskOwner ;
    rdfs:label "AI risk approver for Financial Planning"@en ;
    ent-gov:accountableFor ent-gov:AIRiskAndControls ;
    ent-gov:heldBy "AI Risk Office (placeholder)" ;
    ent-gov:reviewTeam "@example-org/ai-risk-office" .
