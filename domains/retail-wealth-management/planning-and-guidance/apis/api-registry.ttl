@prefix dct:             <http://purl.org/dc/terms/> .
@prefix ent-av:          <https://ontology.example.com/governance/annotations/> .
@prefix ent-gov:         <https://ontology.example.com/governance/model/> .
@prefix ent-tax:         <https://ontology.example.com/taxonomy/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix pg:              <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/planning/> .
@prefix pg-api:          <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/apis/> .
@prefix pg-m:            <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/governance/> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/apis/>
    a owl:Ontology ;
    rdfs:label "Planning and Guidance - domain APIs"@en ;
    dct:abstract "Domain APIs for goals, plans and goal projections, and the ontology concepts they serve."@en ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/apis/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

pg-api:PlanningApi a ent-gov:DomainApi ;
    rdfs:label "Self-Directed Planning API"@en ;
    skos:definition "Create and read a customer's financial goals and self-directed plans, and read goal projections."@en ;
    ent-gov:apiSpecification "apis/planning-api.openapi.yaml"^^xsd:anyURI ;
    ent-gov:servesConcept pg:FinancialGoal , pg:SelfDirectedPlan , pg:GoalProjection ;
    ent-gov:hasApiOwner pg-m:ApiOwnerRole ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .
