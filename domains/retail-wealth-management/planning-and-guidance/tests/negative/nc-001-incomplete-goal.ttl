@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix pg:               <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/planning/> .
@prefix pg-ex:            <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/examples/> .

# NEGATIVE (PG-R-001): goal without a target date, and a target amount without currency.
pg-ex:bad-goal a pg:FinancialGoal ;
    pg:hasGoalReference "G-9001" ;
    pg:hasGoalOwner pg-ex:customer-001 ;
    pg:hasTargetAmount pg-ex:bad-goal-amount .

pg-ex:bad-goal-amount a fibo-fnd-acc-cur:MonetaryAmount ;
    fibo-fnd-acc-cur:hasAmount 50000.00 .
