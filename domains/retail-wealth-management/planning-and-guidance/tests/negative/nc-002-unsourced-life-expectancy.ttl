@prefix fibo-fnd-acc-4217: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .
@prefix fibo-fnd-acc-cur:  <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix pg:                <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/planning/> .
@prefix pg-ex:             <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/examples/> .

# NEGATIVE (PG-R-002, PG-R-004): a life expectancy assumption with no mortality table,
# and a retirement projection whose scenario has no life expectancy assumption at all.
pg-ex:bad-life-assumption a pg:LifeExpectancyAssumption ;
    pg:assumedValue 95 .

pg-ex:scenario-no-life a pg:PlanningScenario ;
    pg:usesAssumption pg-ex:assumption-return .

pg-ex:bad-projection a pg:GoalProjection ;
    pg:projectsGoal pg-ex:goal-retirement ;
    pg:producedByScenario pg-ex:scenario-no-life ;
    pg:hasProjectedAmount pg-ex:bad-projection-amount ;
    pg:probabilityOfSuccess 0.81 .

pg-ex:bad-projection-amount a fibo-fnd-acc-cur:MonetaryAmount ;
    fibo-fnd-acc-cur:hasAmount 1100000.00 ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:USD .
