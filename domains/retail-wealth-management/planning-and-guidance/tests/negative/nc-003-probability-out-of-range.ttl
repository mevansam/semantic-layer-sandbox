@prefix fibo-fnd-acc-4217: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .
@prefix fibo-fnd-acc-cur:  <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix pg:                <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/planning/> .
@prefix pg-ex:             <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/examples/> .

# NEGATIVE (PG-R-003): probability of success above 1.
pg-ex:bad-probability a pg:GoalProjection ;
    pg:projectsGoal pg-ex:goal-retirement ;
    pg:producedByScenario pg-ex:scenario-base ;
    pg:hasProjectedAmount pg-ex:bad-probability-amount ;
    pg:probabilityOfSuccess 1.4 .

pg-ex:bad-probability-amount a fibo-fnd-acc-cur:MonetaryAmount ;
    fibo-fnd-acc-cur:hasAmount 1000000.00 ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:USD .
