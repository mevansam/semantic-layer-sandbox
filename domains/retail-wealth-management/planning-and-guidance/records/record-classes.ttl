@prefix dct:             <http://purl.org/dc/terms/> .
@prefix ent-av:          <https://ontology.example.com/governance/annotations/> .
@prefix ent-gov:         <https://ontology.example.com/governance/model/> .
@prefix ent-tax:         <https://ontology.example.com/taxonomy/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix pg:              <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/planning/> .
@prefix pg-m:            <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/governance/> .
@prefix pg-rec:          <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/records/> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/records/>
    a owl:Ontology ;
    rdfs:label "Planning and Guidance - record classes"@en ;
    dct:abstract "Records created by planning: versions of self-directed plans and their projections."@en ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/records/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

pg-rec:PlanRecord a ent-gov:RecordClass ;
    rdfs:label "self-directed plan record"@en ;
    skos:definition "Record of each version of a customer's self-directed plan, its goals, scenarios, assumptions and projections."@en ;
    ent-gov:recordOf pg:SelfDirectedPlan , pg:GoalProjection ;
    ent-gov:retentionPeriod "P6Y"^^xsd:duration ;
    ent-gov:retentionTrigger "plan superseded or customer relationship ended" ;
    ent-gov:legalHoldApplicable true ;
    ent-gov:dispositionMethod "secure deletion after retention unless under legal hold" ;
    ent-gov:hasRecordsOwner pg-m:RecordsOwnerRole ;
    ent-av:regulatoryCitation "PLACEHOLDER: firm records retention schedule class WM-PLAN - confirm with Records" ;
    ent-av:governedBy ent-tax:legal-risk-compliance-and-surveillance.enterprise-risk.content-retention-and-management .
