@prefix pg-m: <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/governance/> .
@prefix ent-fab: <https://ontology.example.com/fabric/model/> .
@prefix ent-ctl: <https://ontology.example.com/governance/controls/> .
@prefix ent-gov: <https://ontology.example.com/governance/model/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Planning and Guidance - GOVERNED KNOWLEDGE COLLECTION(S)
# The only route by which this domain's knowledge reaches AI agents.
# Owned by the domain owner; published by the semantic fabric; risk approved by
# the AI risk office. Standard: docs/standards/08-semantic-fabric.md
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/governance/collections/>
    a owl:Ontology ;
    rdfs:label "Planning and Guidance - knowledge collections"@en ;
    dct:abstract "Knowledge collections published by Planning and Guidance, their named-graph partitions, usage policies and risk assessments."@en ;
    owl:versionIRI <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/governance/collections/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

pg-m:Collection a ent-fab:KnowledgeCollection ;
    rdfs:label "Planning and Guidance knowledge"@en ;
    dct:description "Ontology, rules, processes, APIs, stewardship, records and execution models of Planning and Guidance."@en ;
    ent-fab:publishedBy <https://ontology.example.com/capability/domain/investment-servicing/retail-wealth-management/planning-and-guidance> ;
    owl:versionInfo "0.1.0" ;
    ent-fab:sensitivity ent-ctl:Internal ;
    ent-fab:usagePolicy pg-m:CollectionPolicy ;
    ent-fab:subjectToControl ent-ctl:CTL-001 , ent-ctl:CTL-002 , ent-ctl:CTL-003 , ent-ctl:CTL-007 ;
    ent-fab:hasRiskAssessment pg-m:CollectionRiskAssessment ;
    ent-gov:hasDataSteward pg-m:DataStewardRole ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:OntologyPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/ontology"^^xsd:anyURI ;
        ent-fab:sourcePath "ontology/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:RulesPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/rules"^^xsd:anyURI ;
        ent-fab:sourcePath "rules/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:ProcessesPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/processes"^^xsd:anyURI ;
        ent-fab:sourcePath "processes/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:ApisPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/apis"^^xsd:anyURI ;
        ent-fab:sourcePath "apis/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:StewardshipPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/stewardship"^^xsd:anyURI ;
        ent-fab:sourcePath "stewardship/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:RecordsPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/records"^^xsd:anyURI ;
        ent-fab:sourcePath "records/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:ManifestPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/manifest"^^xsd:anyURI ;
        ent-fab:sourcePath "domain-manifest.ttl" ;
        ent-fab:sourcePath "collections/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:ExecutionPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/execution"^^xsd:anyURI ;
        ent-fab:sourcePath "execution-models/*.ttl" ;
    ] .

pg-m:CollectionPolicy a odrl:Policy , odrl:Set ;
    rdfs:label "usage policy for Planning and Guidance knowledge"@en ;
    odrl:uid <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/governance/CollectionPolicy> ;
    # Customer-facing agents may use this knowledge ONLY for self-directed guidance.
    odrl:permission [
        odrl:target pg-m:Collection ;
        odrl:assignee ent-fab:CustomerFacingAgent ;
        odrl:action odrl:use ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:eq ;
                          odrl:rightOperand ent-fab:SelfDirectedGuidance ]
    ] , [
        odrl:target pg-m:Collection ;
        odrl:assignee ent-fab:AssociateAssistAgent , ent-fab:InternalAnalystAgent ;
        odrl:action odrl:use ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:isAnyOf ;
                          odrl:rightOperand ent-fab:SelfDirectedGuidance , ent-fab:InternalAnalytics ]
    ] ;
    # Never as the basis of personalized advice (advice boundary, ALN-002 / IA-R-001).
    odrl:prohibition [
        odrl:target pg-m:Collection ;
        odrl:action odrl:use ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:eq ; odrl:rightOperand ent-fab:PersonalizedAdvice ]
    ] , [
        odrl:target pg-m:Collection ;
        odrl:assignee ent-fab:ExternalModelProvider ;
        odrl:action odrl:use
    ] , [
        odrl:target pg-m:Collection ;
        odrl:action odrl:use ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:eq ; odrl:rightOperand ent-fab:ModelTraining ]
    ] .

pg-m:CollectionRiskAssessment ;
    ent-gov:hasDataSteward pg-m:DataStewardRole ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:OntologyPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/ontology"^^xsd:anyURI ;
        ent-fab:sourcePath "ontology/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:RulesPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/rules"^^xsd:anyURI ;
        ent-fab:sourcePath "rules/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:ProcessesPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/processes"^^xsd:anyURI ;
        ent-fab:sourcePath "processes/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:ApisPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/apis"^^xsd:anyURI ;
        ent-fab:sourcePath "apis/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:StewardshipPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/stewardship"^^xsd:anyURI ;
        ent-fab:sourcePath "stewardship/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:RecordsPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/records"^^xsd:anyURI ;
        ent-fab:sourcePath "records/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:ManifestPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/manifest"^^xsd:anyURI ;
        ent-fab:sourcePath "domain-manifest.ttl" ;
        ent-fab:sourcePath "collections/*.ttl" ;
    ] ;
    ent-fab:hasPartition [
        a ent-fab:GraphPartition ;
        ent-fab:partitionKind ent-fab:ExecutionPartition ;
        ent-fab:graphName "https://ontology.example.com/graph/rwm-pg/planning-and-guidance/v0.1.0/execution"^^xsd:anyURI ;
        ent-fab:sourcePath "execution-models/*.ttl" ;
    ] .

pg-m:CollectionPolicy a odrl:Policy , odrl:Set ;
    rdfs:label "usage policy for Planning and Guidance knowledge"@en ;
    odrl:uid <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/governance/CollectionPolicy> ;
    odrl:permission [
        odrl:target pg-m:Collection ;
        odrl:assignee ent-fab:InternalAnalystAgent , ent-fab:AssociateAssistAgent ;
        odrl:action odrl:use ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:isAnyOf ;
                          odrl:rightOperand ent-fab:InternalAnalytics ]
    ] ;
    odrl:prohibition [
        odrl:target pg-m:Collection ;
        odrl:assignee ent-fab:ExternalModelProvider ;
        odrl:action odrl:use
    ] , [
        odrl:target pg-m:Collection ;
        odrl:action odrl:use ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:eq ; odrl:rightOperand ent-fab:ModelTraining ]
    ] .

pg-m:CollectionRiskAssessment a ent-ctl:RiskAssessment ;
    rdfs:label "AI risk assessment - Planning and Guidance knowledge collection"@en ;
    ent-ctl:assesses pg-m:Collection ;
    ent-ctl:identifiedRisk ent-ctl:RSK-001 , ent-ctl:RSK-002 , ent-ctl:RSK-003 ;
    ent-ctl:residualRiskRating ent-ctl:Low ;
    ent-ctl:approvedBy pg-m:AIRiskApprover ;
    ent-ctl:assessmentDate "2026-09-29"^^xsd:date .
