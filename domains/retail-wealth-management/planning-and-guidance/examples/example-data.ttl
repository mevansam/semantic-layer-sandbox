@prefix ent-core:          <https://ontology.example.com/fibo-ext/core/> .
@prefix fibo-fbc-pas-caa:  <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/> .
@prefix fibo-fnd-acc-4217: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .
@prefix fibo-fnd-acc-cur:  <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix pg:                <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/planning/> .
@prefix pg-ex:             <https://ontology.example.com/domain/retail-wealth-management/planning-and-guidance/examples/> .
@prefix rdfs:              <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:               <http://www.w3.org/2001/XMLSchema#> .

# POSITIVE EXAMPLES - Planning and Guidance (synthetic). Must pass every PG rule;
# used by competency questions and the goal-progress tool.

# -----------------------------------------------------------------------------
# POSITIVE EXAMPLES - a fictitious customer's self-directed planning journey.
# Must conform to every rule (gate G5); used by competency questions and tools.
# Entirely synthetic data.
# -----------------------------------------------------------------------------
# ---- Customer and account -------------------------------------------------------
pg-ex:customer-001 a ent-core:RetailCustomer ;
    rdfs:label "Customer 001 (synthetic)" .

pg-ex:account-001 a fibo-fbc-pas-caa:InvestmentAccount ;
    rdfs:label "Retirement brokerage account (synthetic)" .

# ---- Reference data (normally from Common Reference Data) --------------------------
pg-ex:mortality-table-2024 a ent-core:MortalityTable ;
    rdfs:label "Example Mortality Table 2024 (synthetic)" ;
    ent-core:tableVersion "2024.1" .

# ---- Goal and plan -------------------------------------------------------------------
pg-ex:goal-retirement a pg:RetirementGoal ;
    rdfs:label "Retire at 67" ;
    pg:hasGoalReference "G-0001" ;
    pg:hasGoalOwner pg-ex:customer-001 ;
    pg:hasTargetAmount pg-ex:goal-retirement-target ;
    pg:hasTargetDate "2055-06-30"^^xsd:date ;
    pg:isFundedBy pg-ex:account-001 .

pg-ex:goal-retirement-target a fibo-fnd-acc-cur:MonetaryAmount ;
    fibo-fnd-acc-cur:hasAmount 1200000.00 ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:USD .

pg-ex:plan-001 a pg:SelfDirectedPlan ;
    rdfs:label "Customer 001 retirement plan" ;
    ent-core:hasDeliveryModel ent-core:SelfDirected ;
    pg:hasPlanGoal pg-ex:goal-retirement ;
    pg:hasScenario pg-ex:scenario-base .

# ---- Scenario, assumptions and projection ---------------------------------------------
pg-ex:scenario-base a pg:PlanningScenario ;
    rdfs:label "Base case" ;
    pg:usesAssumption pg-ex:assumption-return , pg-ex:assumption-inflation , pg-ex:assumption-life .

pg-ex:assumption-return a pg:PlanningAssumption ;
    rdfs:label "expected annual portfolio return" ;
    pg:assumedValue 0.050 .

pg-ex:assumption-inflation a pg:PlanningAssumption ;
    rdfs:label "expected annual inflation" ;
    pg:assumedValue 0.025 .

pg-ex:assumption-life a pg:LifeExpectancyAssumption ;
    rdfs:label "life expectancy" ;
    pg:assumedValue 92 ;
    pg:sourcedFromTable pg-ex:mortality-table-2024 .

pg-ex:projection-001 a pg:GoalProjection ;
    pg:projectsGoal pg-ex:goal-retirement ;
    pg:producedByScenario pg-ex:scenario-base ;
    pg:hasProjectedAmount pg-ex:projection-001-amount ;
    pg:probabilityOfSuccess 0.78 .

pg-ex:projection-001-amount a fibo-fnd-acc-cur:MonetaryAmount ;
    fibo-fnd-acc-cur:hasAmount 1050000.00 ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:USD .
