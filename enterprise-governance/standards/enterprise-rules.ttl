ent-ms:PropertyNamingShape ent-gov:definedIn "enterprise-governance/docs/standards/01-ontology-standards.md#3-naming" ;
    ent-gov:justifiedBy ent-adr:ADR-0011 .
ent-ms:BusinessClassShape ent-gov:definedIn "enterprise-governance/docs/standards/01-ontology-standards.md#1-fibo-is-the-upper-ontology" ;
    ent-gov:justifiedBy ent-adr:ADR-0001 .
ent-ms:BusinessPropertyShape ent-gov:definedIn "enterprise-governance/docs/standards/01-ontology-standards.md#1-fibo-is-the-upper-ontology" ;
