ent-ms:DataProductShape ent-gov:definedIn "enterprise-governance/docs/standards/04-apis-data-records.md" ;
    ent-gov:justifiedBy ent-adr:ADR-0002 .
ent-ms:RecordClassShape ent-gov:definedIn "enterprise-governance/docs/standards/04-apis-data-records.md" ;
    ent-gov:justifiedBy ent-adr:ADR-0002 .
ent-ms:KnowledgeCollectionShape ent-gov:definedIn "enterprise-governance/docs/standards/08-semantic-fabric.md" ;
    ent-gov:justifiedBy ent-adr:ADR-0011 .
ent-ms:GraphPartitionShape ent-gov:definedIn "enterprise-governance/docs/standards/08-semantic-fabric.md" ;
    ent-gov:justifiedBy ent-adr:ADR-0011 .
ent-ms:UsagePolicyShape ent-gov:definedIn "enterprise-governance/docs/standards/08-semantic-fabric.md" ;
    ent-gov:justifiedBy ent-adr:ADR-0011 .
ent-ms:ExecutionModelShape ent-gov:definedIn "enterprise-governance/docs/standards/08-semantic-fabric.md" ;
