ent-ms:ParentDomainManifestShape ent-gov:definedIn "enterprise-governance/standards/domain-repo-structure.yaml" ;
    ent-gov:justifiedBy ent-adr:ADR-0005 .
ent-ms:SubDomainDependencyShape ent-gov:definedIn "enterprise-governance/docs/standards/01-ontology-standards.md#5-modularity" ;
    ent-gov:justifiedBy ent-adr:ADR-0005 , ent-adr:ADR-0006 .
ent-ms:BusinessRuleShape ent-gov:definedIn "enterprise-governance/docs/standards/02-business-rules.md" ;
