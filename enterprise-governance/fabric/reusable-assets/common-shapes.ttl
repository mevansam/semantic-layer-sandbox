@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix ent-ra:  <https://ontology.example.com/fabric/assets/> .
@prefix ent-fab: <https://ontology.example.com/fabric/model/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .

# -----------------------------------------------------------------------------
# Reusable semantic assets (Semantic Fabric)
#
# Shapes that recur across domains. Domains reuse them with sh:node rather than
# re-writing them, so the same constraint means the same thing everywhere and
# agents see one explanation. Add new assets through semantic review.
# -----------------------------------------------------------------------------

@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .

<https://ontology.example.com/fabric/assets/>
    a owl:Ontology ;
    rdfs:label "Reusable Semantic Assets"@en ;
    dct:abstract "Shared shapes and modelling patterns published by the semantic fabric for reuse across domains."@en ;
    owl:versionIRI <https://ontology.example.com/fabric/assets/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

ent-ra:MonetaryAmountShape a sh:NodeShape , ent-fab:ReusableAsset ;
    rdfs:label "monetary amount (FIBO)" ;
    skos:definition "Reusable constraint: a FIBO monetary amount carries exactly one decimal amount and exactly one currency."@en ;
    ent-fab:assetKind ent-fab:ShapeAsset ;
    sh:property [ sh:path fibo-fnd-acc-cur:hasAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "A monetary amount needs exactly one xsd:decimal amount." ] ;
    sh:property [ sh:path fibo-fnd-acc-cur:hasCurrency ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A monetary amount needs exactly one currency." ] .

ent-ra:ModelProvenanceShape a sh:NodeShape , ent-fab:ReusableAsset ;
    rdfs:label "model-generated output provenance" ;
    skos:definition "Reusable constraint for any analytic or AI-generated output delivered to a customer or associate: it records the generating model identifier, model version and generation time (supports CTL-002, CTL-008)."@en ;
    ent-fab:assetKind ent-fab:ShapeAsset ;
    sh:property [ sh:path ent-ra:generatedByModel ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "Record the identifier of the model that generated this output." ] ;
    sh:property [ sh:path ent-ra:modelVersion ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "Record the version of the model that generated this output." ] ;
    sh:property [ sh:path ent-ra:generatedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "Record when this output was generated." ] .

ent-ra:generatedByModel a owl:DatatypeProperty ;
    rdfs:label "generated by model"@en ;
    skos:definition "Identifier of the analytic or AI model that generated an output."@en ;
    rdfs:range xsd:string .
ent-ra:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version"@en ;
    skos:definition "Version of the model that generated an output."@en ;
    rdfs:range xsd:string .
ent-ra:generatedAt a owl:DatatypeProperty ;
    rdfs:label "generated at"@en ;
    skos:definition "Date and time at which an output was generated."@en ;
    rdfs:range xsd:dateTime .

ent-ra:PercentageScoreShape a sh:NodeShape , ent-fab:ReusableAsset ;
    rdfs:label "0-100 score" ;
    skos:definition "Reusable constraint for scores expressed on a 0-100 scale."@en ;
    ent-fab:assetKind ent-fab:ShapeAsset ;
    sh:property [ sh:path ent-ra:scoreValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                  sh:minInclusive 0 ; sh:maxInclusive 100 ;
                  sh:message "Scores are decimals between 0 and 100 inclusive." ] .

ent-ra:scoreValue a owl:DatatypeProperty ;
    rdfs:label "score value"@en ;
    skos:definition "Numeric value of a score on its declared scale."@en ;
    rdfs:range xsd:decimal .

ent-ra:DatePeriodPattern a ent-fab:ReusableAsset ;
    rdfs:label "date period pattern" ;
    skos:definition "Modelling pattern: use xsd:date-valued properties for simple calendar dates (target date, as-of date); use FIBO FinancialDates for schedules, periods and relative or calculated dates. Do not mint domain-specific date classes."@en ;
    ent-fab:assetKind ent-fab:PatternAsset ;
    dct:references <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/> .
