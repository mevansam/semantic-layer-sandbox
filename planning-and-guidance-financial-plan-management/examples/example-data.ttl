@prefix fa:  <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/assessments/> .
@prefix sdp:    <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/> .
@prefix sdp-ex: <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/examples/> .
@prefix ent-core: <https://ontology.example.com/fibo-ext/core/> .
@prefix ent-ra:   <https://ontology.example.com/fabric/assets/> .
@prefix fibo-fnd-acc-cur:  <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-acc-4217: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .
@prefix fibo-fbc-pas-caa:  <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# POSITIVE EXAMPLES - a fictitious customer's self-directed planning journey.
# Must conform to every rule (gate G5); used by competency questions and tools.
# Entirely synthetic data.
# -----------------------------------------------------------------------------

# ---- Customer and account -------------------------------------------------------

sdp-ex:customer-001 a ent-core:RetailCustomer ;
    rdfs:label "Customer 001 (synthetic)" .

sdp-ex:account-001 a fibo-fbc-pas-caa:InvestmentAccount ;
    rdfs:label "Retirement brokerage account (synthetic)" .

# ---- Reference data (normally from Common Reference Data) --------------------------

sdp-ex:mortality-table-2024 a ent-core:MortalityTable ;
    rdfs:label "Example Mortality Table 2024 (synthetic)" ;
    ent-core:tableVersion "2024.1" .

# ---- Goal and plan -------------------------------------------------------------------

sdp-ex:goal-retirement a sdp:RetirementGoal ;
    rdfs:label "Retire at 67" ;
    sdp:hasGoalReference "G-0001" ;
    sdp:hasGoalOwner sdp-ex:customer-001 ;
    sdp:hasTargetAmount sdp-ex:goal-retirement-target ;
    sdp:hasTargetDate "2055-06-30"^^xsd:date ;
    sdp:isFundedBy sdp-ex:account-001 .

sdp-ex:goal-retirement-target a fibo-fnd-acc-cur:MonetaryAmount ;
    fibo-fnd-acc-cur:hasAmount 1200000.00 ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:USD .

sdp-ex:plan-001 a sdp:SelfDirectedPlan ;
    rdfs:label "Customer 001 retirement plan" ;
    ent-core:hasDeliveryModel ent-core:SelfDirected ;
    sdp:hasPlanGoal sdp-ex:goal-retirement ;
    sdp:hasScenario sdp-ex:scenario-base .

# ---- Scenario, assumptions and projection ---------------------------------------------

sdp-ex:scenario-base a sdp:PlanningScenario ;
    rdfs:label "Base case" ;
    sdp:usesAssumption sdp-ex:assumption-return , sdp-ex:assumption-inflation , sdp-ex:assumption-life .

sdp-ex:assumption-return a sdp:PlanningAssumption ;
    rdfs:label "expected annual portfolio return" ;
    sdp:assumedValue 0.050 .

sdp-ex:assumption-inflation a sdp:PlanningAssumption ;
    rdfs:label "expected annual inflation" ;
    sdp:assumedValue 0.025 .

sdp-ex:assumption-life a sdp:LifeExpectancyAssumption ;
    rdfs:label "life expectancy" ;
    sdp:assumedValue 92 ;
    sdp:sourcedFromTable sdp-ex:mortality-table-2024 .

sdp-ex:projection-001 a sdp:GoalProjection ;
    sdp:projectsGoal sdp-ex:goal-retirement ;
    sdp:producedByScenario sdp-ex:scenario-base ;
    sdp:hasProjectedAmount sdp-ex:projection-001-amount ;
    sdp:probabilityOfSuccess 0.78 .

sdp-ex:projection-001-amount a fibo-fnd-acc-cur:MonetaryAmount ;
    fibo-fnd-acc-cur:hasAmount 1050000.00 ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:USD .

# ---- Financial health score ----------------------------------------------------------------

sdp-ex:health-score-001 a fa:FinancialHealthScore ;
    fa:scoresCustomer sdp-ex:customer-001 ;
    ent-ra:scoreValue 72.0 ;
    ent-ra:generatedByModel "fin-health-model" ;
    ent-ra:modelVersion "3.2.0" ;
    ent-ra:generatedAt "2026-09-28T09:00:00Z"^^xsd:dateTime .

# ---- Self-directed insights (both compliant with SDP-R-001 and SDP-R-005) -------------------

sdp-ex:insight-001 a sdp:SelfDirectedInsight ;
    ent-core:hasDeliveryModel ent-core:SelfDirected ;
    sdp:insightFor sdp-ex:customer-001 ;
    sdp:relatesToGoal sdp-ex:goal-retirement ;
    sdp:hasInsightCategory sdp:SavingsRate , sdp:RetirementReadiness ;
    sdp:suggestsAction sdp:IncreaseContributions ;
    sdp:insightText "You're on track for about 78% of scenarios. Saving an extra 2% of salary each year would close most of the gap to your retirement goal." ;
    ent-ra:generatedByModel "insight-generator" ;
    ent-ra:modelVersion "1.4.0" ;
    ent-ra:generatedAt "2026-09-28T09:00:05Z"^^xsd:dateTime .

sdp-ex:insight-002 a sdp:SelfDirectedInsight ;
    ent-core:hasDeliveryModel ent-core:SelfDirected ;
    sdp:insightFor sdp-ex:customer-001 ;
    sdp:hasInsightCategory sdp:DiversificationEducation ;
    sdp:suggestsAction sdp:LearnMore ;
    sdp:insightText "Most of your retirement savings sit in one asset class. Learn how diversification can affect the range of outcomes in your plan." ;
    ent-ra:generatedByModel "insight-generator" ;
    ent-ra:modelVersion "1.4.0" ;
    ent-ra:generatedAt "2026-09-28T09:00:06Z"^^xsd:dateTime .
