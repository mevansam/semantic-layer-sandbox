@prefix sdp: <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/> .
@prefix fa:  <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/assessments/> .
@prefix ent-av:   <https://ontology.example.com/governance/annotations/> .
@prefix ent-tax:  <https://ontology.example.com/taxonomy/> .
@prefix ent-core: <https://ontology.example.com/fibo-ext/core/> .
@prefix fibo-fnd-utl-av:  <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-fnd-gao-obj: <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-arr-asmt: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/> .
@prefix fibo-fnd-utl-alx: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/> .
@prefix fibo-fbc-pas-caa: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/> .
@prefix fibo-fbc-fi-fi:   <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Financial Plan Management - ASSESSMENTS module
#
# Financial health scoring. Incubated here because Financial Assessments (the
# accountable business domain in the capability map) has no repository yet;
# the module is kept separate so it can be transferred whole to pg-fa.
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/assessments/>
    a owl:Ontology ;
    rdfs:label "Financial Plan Management - assessments"@en ;
    dct:abstract "Financial health score of a retail customer, specializing FIBO key performance indicators. Earmarked for the Financial Assessments business domain."@en ;
    owl:imports <https://ontology.example.com/fibo-ext/core/> ;
    owl:versionIRI <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/assessments/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

fa:FinancialHealthScore a owl:Class ;
    rdfs:subClassOf fibo-fnd-utl-alx:KeyPerformanceIndicator ;
    rdfs:label "financial health score"@en ;
    skos:definition "key performance indicator, on a 0-100 scale, summarizing a retail customer's overall financial resilience from savings, debt, protection and progress towards goals"@en ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-health-scores ;
    ent-av:agentGuidance "Explain which factors drive the score; do not compare a customer's score with other named customers."@en ;
    ent-av:owningDomain <https://ontology.example.com/capability/domain/planning-and-guidance/financial-assessments> ;
    ent-av:realizesCapability <https://ontology.example.com/capability/financial-assessment.financial-wellness-assessment> ;
    skos:editorialNote "Incubated in Financial Plan Management; meaning owned by Financial Assessments (ADR-0004). Transfer this module to the pg-fa repository when it is created."@en .

fa:scoresCustomer a owl:ObjectProperty ;
    rdfs:label "scores customer"@en ;
    skos:definition "relates a financial health score to the customer it describes"@en ;
    rdfs:domain fa:FinancialHealthScore ; rdfs:range ent-core:RetailCustomer ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-health-scores .
