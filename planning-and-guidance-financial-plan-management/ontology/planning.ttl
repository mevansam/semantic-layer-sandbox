@prefix sdp: <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/> .
@prefix ent-av:   <https://ontology.example.com/governance/annotations/> .
@prefix ent-tax:  <https://ontology.example.com/taxonomy/> .
@prefix ent-core: <https://ontology.example.com/fibo-ext/core/> .
@prefix fibo-fnd-utl-av:  <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-fnd-gao-obj: <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-arr-asmt: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/> .
@prefix fibo-fnd-utl-alx: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/> .
@prefix fibo-fbc-pas-caa: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/> .
@prefix fibo-fbc-fi-fi:   <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Financial Plan Management - PLANNING module (self-directed wealth planning, insights & analytics)
#
# MEANING owned by: Financial Plan Management domain owner (see domain-manifest.ttl).
# Scope of this seed slice: goals, plans, scenarios & assumptions, projections,
# financial health scores and self-directed insights - enough to exercise every
# accountability (rules, APIs, data, records) and every fabric artefact.
# Every class specializes FIBO (or enterprise core) and is anchored to the
# enterprise taxonomy.
# -----------------------------------------------------------------------------

<https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/>
    a owl:Ontology ;
    rdfs:label "Financial Plan Management - planning"@en ;
    dct:abstract "Financial goals, self-directed plans, planning scenarios and assumptions, goal projections and self-directed planning insights for retail customers, specializing FIBO."@en ;
    owl:imports <https://ontology.example.com/fibo-ext/core/> ;
    owl:versionIRI <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/0.1.0/> ;
    owl:versionInfo "0.1.0" ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional .

# =============================================================================
# Goals and plans
# =============================================================================

sdp:FinancialGoal a owl:Class ;
    rdfs:subClassOf fibo-fnd-gao-obj:FinancialObjective ;
    rdfs:label "financial goal"@en ;
    skos:definition "financial objective that a retail customer sets for themselves, expressed as a target amount of money to be available by a target date"@en ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ;
    ent-av:businessExample "Have $1.2M saved for retirement by June 2055."@en ;
    ent-av:agentGuidance "A goal belongs to the customer who set it. Report progress using the latest goal projection; never state that a goal will be achieved - projections are estimates."@en .

sdp:RetirementGoal a owl:Class ;
    rdfs:subClassOf sdp:FinancialGoal ;
    rdfs:label "retirement goal"@en ;
    skos:definition "financial goal whose purpose is to fund the customer's living expenses after they stop working"@en ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ;
    ent-av:agentGuidance "Retirement projections depend on a life-expectancy assumption from a governed mortality table (rule SDP-R-003); mention the assumption when explaining results."@en .

sdp:FinancialPlan a owl:Class ;
    rdfs:subClassOf fibo-fnd-gao-obj:Strategy ;
    rdfs:label "financial plan"@en ;
    skos:definition "strategy that sets out how a customer intends to reach one or more financial goals, including the scenarios under which progress is projected"@en ;
    skos:editorialNote "FIBO-GAP: FIBO has no 'plan' concept distinct from strategy; Strategy is the closest parent."@en ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ;
    ent-av:agentGuidance "Distinguish self-directed plans (customer-built with tools) from advised plans (built with an associate). This domain holds only self-directed plans."@en .

sdp:SelfDirectedPlan a owl:Class ;
    rdfs:subClassOf sdp:FinancialPlan ;
    rdfs:label "self-directed plan"@en ;
    skos:definition "financial plan that the customer builds and maintains themselves using digital planning tools, without a personalized recommendation from an associate"@en ;
    ent-av:governedBy ent-tax:products-and-services.planning-and-guidance-services ;
    ent-av:agentGuidance "Everything produced for a self-directed plan is educational and generic, never a personalized recommendation (see SDP-R-001)."@en .

sdp:hasPlanGoal a owl:ObjectProperty ;
    rdfs:subPropertyOf fibo-fnd-gao-obj:hasObjective ;
    rdfs:label "has plan goal"@en ;
    skos:definition "relates a financial plan to a goal it is intended to achieve"@en ;
    rdfs:domain sdp:FinancialPlan ; rdfs:range sdp:FinancialGoal ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:hasGoalOwner a owl:ObjectProperty ;
    rdfs:label "has goal owner"@en ;
    skos:definition "relates a financial goal to the retail customer who set it"@en ;
    rdfs:domain sdp:FinancialGoal ; rdfs:range ent-core:RetailCustomer ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:hasGoalReference a owl:DatatypeProperty ;
    rdfs:label "has goal reference"@en ;
    skos:definition "business identifier of a financial goal, unique within the planning platform"@en ;
    rdfs:domain sdp:FinancialGoal ; rdfs:range xsd:string ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:hasTargetAmount a owl:ObjectProperty ;
    rdfs:label "has target amount"@en ;
    skos:definition "the amount of money the goal aims to have available at the target date"@en ;
    rdfs:domain sdp:FinancialGoal ; rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:hasTargetDate a owl:DatatypeProperty ;
    rdfs:label "has target date"@en ;
    skos:definition "the date by which the target amount of a goal should be available"@en ;
    rdfs:domain sdp:FinancialGoal ; rdfs:range xsd:date ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:isFundedBy a owl:ObjectProperty ;
    rdfs:label "is funded by"@en ;
    skos:definition "relates a financial goal to an account whose assets the customer has earmarked towards it"@en ;
    rdfs:domain sdp:FinancialGoal ; rdfs:range fibo-fbc-pas-caa:Account ;
    ent-av:governedBy ent-tax:accounts.brokerage-accounts.account-balances-and-positions .

# =============================================================================
# Scenarios, assumptions and projections
# =============================================================================

sdp:PlanningScenario a owl:Class ;
    rdfs:subClassOf fibo-fnd-arr-asmt:AssessmentActivity ;
    rdfs:label "planning scenario"@en ;
    skos:definition "assessment activity that projects the outcome of a financial plan under a stated set of planning assumptions"@en ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ;
    ent-av:agentGuidance "Always state the key assumptions of a scenario when quoting its projections."@en .

sdp:PlanningAssumption a owl:Class ;
    rdfs:subClassOf fibo-fnd-arr-asmt:ExpectedValue ;
    rdfs:label "planning assumption"@en ;
    skos:definition "expected value, such as a rate of return, inflation rate or life expectancy, that a planning scenario takes as given"@en ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ;
    ent-av:agentGuidance "Assumptions are inputs, not forecasts made by the firm; describe them as assumptions."@en .

sdp:LifeExpectancyAssumption a owl:Class ;
    rdfs:subClassOf sdp:PlanningAssumption ;
    rdfs:label "life expectancy assumption"@en ;
    skos:definition "planning assumption of the age to which the customer is expected to live, derived from a governed mortality table"@en ;
    ent-av:governedBy ent-tax:common-reference.mortality-tables ;
    ent-av:agentGuidance "Cite the mortality table and version; never infer life expectancy from health or other personal data."@en .

sdp:hasScenario a owl:ObjectProperty ;
    rdfs:label "has scenario"@en ;
    skos:definition "relates a financial plan to a planning scenario run for it"@en ;
    rdfs:domain sdp:FinancialPlan ; rdfs:range sdp:PlanningScenario ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:usesAssumption a owl:ObjectProperty ;
    rdfs:label "uses assumption"@en ;
    skos:definition "relates a planning scenario to an assumption it takes as given"@en ;
    rdfs:domain sdp:PlanningScenario ; rdfs:range sdp:PlanningAssumption ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:assumedValue a owl:DatatypeProperty ;
    rdfs:label "assumed value"@en ;
    skos:definition "numeric value of a planning assumption (rates as decimals, e.g. 0.05 for 5%; ages in years)"@en ;
    rdfs:domain sdp:PlanningAssumption ; rdfs:range xsd:decimal ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:sourcedFromTable a owl:ObjectProperty ;
    rdfs:label "sourced from table"@en ;
    skos:definition "relates a life expectancy assumption to the mortality table it is derived from"@en ;
    rdfs:domain sdp:LifeExpectancyAssumption ; rdfs:range ent-core:MortalityTable ;
    ent-av:governedBy ent-tax:common-reference.mortality-tables .

sdp:GoalProjection a owl:Class ;
    rdfs:subClassOf fibo-fnd-arr-asmt:ExpectedValue ;
    rdfs:label "goal projection"@en ;
    skos:definition "expected value of the amount available for a financial goal at its target date, produced by a planning scenario, together with the estimated probability of reaching the target"@en ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans ;
    ent-av:agentGuidance "Quote the probability of success as an estimate under the scenario's assumptions, never as a guarantee."@en .

sdp:projectsGoal a owl:ObjectProperty ;
    rdfs:label "projects goal"@en ;
    skos:definition "relates a goal projection to the goal it projects"@en ;
    rdfs:domain sdp:GoalProjection ; rdfs:range sdp:FinancialGoal ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:producedByScenario a owl:ObjectProperty ;
    rdfs:label "produced by scenario"@en ;
    skos:definition "relates a goal projection to the planning scenario that produced it"@en ;
    rdfs:domain sdp:GoalProjection ; rdfs:range sdp:PlanningScenario ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:hasProjectedAmount a owl:ObjectProperty ;
    rdfs:label "has projected amount"@en ;
    skos:definition "the amount projected to be available for the goal at its target date"@en ;
    rdfs:domain sdp:GoalProjection ; rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:probabilityOfSuccess a owl:DatatypeProperty ;
    rdfs:label "probability of success"@en ;
    skos:definition "estimated probability, between 0 and 1, that the target amount is reached by the target date under the scenario"@en ;
    rdfs:domain sdp:GoalProjection ; rdfs:range xsd:decimal ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

# =============================================================================
# Insights  (financial health score: see assessments.ttl)
# =============================================================================

sdp:PlanningInsight a owl:Class ;
    rdfs:subClassOf fibo-fnd-arr-asmt:Opinion ;
    rdfs:label "planning insight"@en ;
    skos:definition "opinion, generated from a customer's goals, plans, projections or portfolio analytics, that draws the customer's attention to something relevant to their financial planning"@en ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics ;
    ent-av:agentGuidance "Insights are generated content; always carry model provenance (SDP-R-005) and retain them as records."@en .

sdp:SelfDirectedInsight a owl:Class ;
    rdfs:subClassOf sdp:PlanningInsight ;
    rdfs:label "self-directed insight"@en ;
    skos:definition "planning insight delivered on a self-directed basis, which educates or prompts the customer but does not recommend a specific transaction in a specific security"@en ;
    ent-av:governedBy ent-tax:products-and-services.planning-and-guidance-services ;
    ent-av:agentGuidance "Never phrase a self-directed insight as 'buy' or 'sell' a named security; that is personalized advice (SDP-R-001, alignment ALN-002). Route such requests to the advised channel."@en .

sdp:insightFor a owl:ObjectProperty ;
    rdfs:label "insight for"@en ;
    skos:definition "relates a planning insight to the customer it is addressed to"@en ;
    rdfs:domain sdp:PlanningInsight ; rdfs:range ent-core:RetailCustomer ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics .

sdp:insightText a owl:DatatypeProperty ;
    rdfs:label "insight text"@en ;
    skos:definition "the customer-facing wording of a planning insight"@en ;
    rdfs:domain sdp:PlanningInsight ; rdfs:range xsd:string ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics .

sdp:relatesToGoal a owl:ObjectProperty ;
    rdfs:label "relates to goal"@en ;
    skos:definition "relates a planning insight to a goal it concerns"@en ;
    rdfs:domain sdp:PlanningInsight ; rdfs:range sdp:FinancialGoal ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-financial-goals-and-plans .

sdp:refersToSecurity a owl:ObjectProperty ;
    rdfs:label "refers to security"@en ;
    skos:definition "relates a planning insight to a specific security it mentions"@en ;
    rdfs:domain sdp:PlanningInsight ; rdfs:range fibo-fbc-fi-fi:Security ;
    ent-av:governedBy ent-tax:securities.securities-reference .

sdp:InsightCategory a owl:Class ;
    rdfs:subClassOf cmns-cls:Classifier ;
    rdfs:label "insight category"@en ;
    skos:definition "classifier that groups planning insights by the planning topic they address"@en ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics ;
    ent-av:agentGuidance "Use categories to explain why an insight was shown."@en .

sdp:SavingsRate a owl:NamedIndividual , sdp:InsightCategory ; rdfs:label "savings rate"@en ;
    skos:definition "insights about how much the customer saves relative to their goals"@en .
sdp:RetirementReadiness a owl:NamedIndividual , sdp:InsightCategory ; rdfs:label "retirement readiness"@en ;
    skos:definition "insights about progress towards retirement goals"@en .
sdp:DiversificationEducation a owl:NamedIndividual , sdp:InsightCategory ; rdfs:label "diversification education"@en ;
    skos:definition "educational insights about diversification and asset allocation concepts"@en .
sdp:EmergencyFund a owl:NamedIndividual , sdp:InsightCategory ; rdfs:label "emergency fund"@en ;
    skos:definition "insights about cash reserves for unexpected expenses"@en .

sdp:hasInsightCategory a owl:ObjectProperty ;
    rdfs:label "has insight category"@en ;
    skos:definition "classifies a planning insight by topic"@en ;
    rdfs:domain sdp:PlanningInsight ; rdfs:range sdp:InsightCategory ;
    ent-av:governedBy ent-tax:customers.customer-intelligence-and-analytics.customer-portfolio-analytics .

sdp:SuggestedAction a owl:Class ;
    rdfs:subClassOf cmns-cls:Classifier ;
    rdfs:label "suggested action"@en ;
    skos:definition "classifier for the kind of action a planning insight prompts the customer to consider"@en ;
    ent-av:governedBy ent-tax:products-and-services.planning-and-guidance-services ;
    ent-av:agentGuidance "BuySecurity and SellSecurity are transaction recommendations and are never permitted in self-directed insights."@en .

sdp:IncreaseContributions a owl:NamedIndividual , sdp:SuggestedAction ; rdfs:label "increase contributions"@en ;
    skos:definition "consider saving more towards a goal"@en .
sdp:ReviewAllocation a owl:NamedIndividual , sdp:SuggestedAction ; rdfs:label "review allocation"@en ;
    skos:definition "consider reviewing asset allocation using educational tools"@en .
sdp:LearnMore a owl:NamedIndividual , sdp:SuggestedAction ; rdfs:label "learn more"@en ;
    skos:definition "read educational content on the topic"@en .
sdp:BuySecurity a owl:NamedIndividual , sdp:SuggestedAction ; rdfs:label "buy security"@en ;
    skos:definition "recommendation to purchase a specific security (advised channel only)"@en .
sdp:SellSecurity a owl:NamedIndividual , sdp:SuggestedAction ; rdfs:label "sell security"@en ;
    skos:definition "recommendation to sell a specific security (advised channel only)"@en .

sdp:suggestsAction a owl:ObjectProperty ;
    rdfs:label "suggests action"@en ;
    skos:definition "relates a planning insight to the kind of action it prompts the customer to consider"@en ;
    rdfs:domain sdp:PlanningInsight ; rdfs:range sdp:SuggestedAction ;
    ent-av:governedBy ent-tax:products-and-services.planning-and-guidance-services .
