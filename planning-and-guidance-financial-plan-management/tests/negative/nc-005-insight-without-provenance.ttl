@prefix sdp:    <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/> .
@prefix sdp-ex: <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/examples/> .
@prefix ent-core: <https://ontology.example.com/fibo-ext/core/> .

# NEGATIVE (SDP-R-005): generated insight with no model provenance and no category.
sdp-ex:bad-insight-untraceable a sdp:SelfDirectedInsight ;
    ent-core:hasDeliveryModel ent-core:SelfDirected ;
    sdp:insightFor sdp-ex:customer-001 ;
    sdp:suggestsAction sdp:LearnMore ;
    sdp:insightText "Here is something you might find useful about emergency savings." .
