@prefix sdp:    <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/> .
@prefix sdp-ex: <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/examples/> .
@prefix fibo-fnd-acc-cur:  <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-acc-4217: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .

# NEGATIVE (SDP-R-006): probability of success above 1.
sdp-ex:bad-probability a sdp:GoalProjection ;
    sdp:projectsGoal sdp-ex:goal-retirement ;
    sdp:producedByScenario sdp-ex:scenario-base ;
    sdp:hasProjectedAmount sdp-ex:bad-probability-amount ;
    sdp:probabilityOfSuccess 1.4 .

sdp-ex:bad-probability-amount a fibo-fnd-acc-cur:MonetaryAmount ;
    fibo-fnd-acc-cur:hasAmount 1000000.00 ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:USD .
