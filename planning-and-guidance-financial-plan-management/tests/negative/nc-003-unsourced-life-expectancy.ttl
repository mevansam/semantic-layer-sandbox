@prefix sdp:    <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/planning/> .
@prefix sdp-ex: <https://ontology.example.com/domain/planning-and-guidance/financial-plan-management/examples/> .
@prefix fibo-fnd-acc-cur:  <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-acc-4217: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .

# NEGATIVE (SDP-R-003, SDP-R-007): a life expectancy assumption with no mortality table,
# and a retirement projection whose scenario has no life expectancy assumption at all.
sdp-ex:bad-life-assumption a sdp:LifeExpectancyAssumption ;
    sdp:assumedValue 95 .

sdp-ex:scenario-no-life a sdp:PlanningScenario ;
    sdp:usesAssumption sdp-ex:assumption-return .

sdp-ex:bad-projection a sdp:GoalProjection ;
    sdp:projectsGoal sdp-ex:goal-retirement ;
    sdp:producedByScenario sdp-ex:scenario-no-life ;
    sdp:hasProjectedAmount sdp-ex:bad-projection-amount ;
    sdp:probabilityOfSuccess 0.81 .

sdp-ex:bad-projection-amount a fibo-fnd-acc-cur:MonetaryAmount ;
    fibo-fnd-acc-cur:hasAmount 1100000.00 ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:USD .
